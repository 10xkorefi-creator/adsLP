---
import afkLogo from '../assets/logos/afkgaming.avif';
import buildTrustLogo from '../assets/logos/buildtrust.avif';
import cuttingLogo from '../assets/logos/cutting.avif';
import kettoLogo from '../assets/logos/ketto.avif';
import newtonLogo from '../assets/logos/newtonschool.avif';
import tripIndiaLogo from '../assets/logos/tripindia.avif';
import uplersLogo from '../assets/logos/uplers.avif';

const logos = [
  { src: afkLogo.src, alt: 'AFK Gaming' },
  { src: buildTrustLogo.src, alt: 'Build Trust' },
  { src: cuttingLogo.src, alt: 'Cutting' },
  { src: kettoLogo.src, alt: 'Ketto' },
  { src: newtonLogo.src, alt: 'Newton School' },
  { src: tripIndiaLogo.src, alt: 'Trip India' },
  { src: uplersLogo.src, alt: 'Uplers' },
];
---

<!-- Section 2: Brand Logos / Social Proof Bar -->
<section class="py-12 bg-white border-b border-slate-200 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 relative z-20">
    <h3 class="text-center text-sm md:text-base font-extrabold text-slate-500 uppercase tracking-widest">
      400+ companies have switched to AI Accountant
    </h3>
  </div>

  <!-- Marquee Container -->
  <div class="relative w-full flex overflow-hidden group">
    <!-- Fade edges for smooth disappearing -->
    <div class="absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <!-- Scrolling Track -->
    <div class="flex items-center gap-4 sm:gap-6 w-max animate-marquee hover:play-state-paused" style="will-change: transform; backface-visibility: hidden; transform: translateZ(0);">
      {
        [...logos, ...logos, ...logos].map((logo, index) => (
          <div class="w-[140px] sm:w-[160px] h-16 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-center p-3 hover:border-slate-300 hover:shadow-sm transition-all shrink-0">
            <img src={logo.src} alt={logo.alt} loading={index > 6 ? "lazy" : "eager"} decoding="async" class="max-h-full max-w-full object-contain" style="transform: translateZ(0); backface-visibility: hidden;" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333333%); }
  }
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
  .hover\:play-state-paused:hover {
    animation-play-state: paused;
  }
</style>
