---
// src/components/ca-bot/CaBotHowItWorks.astro
---
<section class="py-24 bg-white w-full border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        How it works
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connection Line (Desktop) -->
      <div class="hidden md:block absolute top-8 left-[15%] right-[15%] h-0.5 bg-slate-200 z-0"></div>

      <!-- Step 1 -->
      <div class="relative z-10 text-center">
        <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg text-2xl font-black text-white">
          1
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Sign your firm up.</h3>
        <p class="text-slate-600 font-medium">
          One short form to get started.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative z-10 text-center">
        <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg text-2xl font-black text-white">
          2
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">We connect your clients' Tally.</h3>
        <p class="text-slate-600 font-medium">
          Securely linked to you.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="relative z-10 text-center">
        <div class="w-16 h-16 bg-[#25D366] rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg text-2xl font-black text-white transform hover:scale-110 transition-transform">
          3
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Your clients start asking.</h3>
        <p class="text-slate-600 font-medium">
          Instant answers on WhatsApp.
        </p>
      </div>

    </div>
  </div>
</section>
