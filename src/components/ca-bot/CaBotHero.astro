---
// src/components/ca-bot/CaBotHero.astro
---
<section class="relative bg-slate-50 pt-16 sm:pt-24 lg:pt-32 pb-20 lg:pb-32 overflow-hidden w-full">
  <!-- Decorative Background -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-blue-500/10 blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Text Content -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100 border border-blue-200 text-blue-800 font-bold text-xs sm:text-sm mb-6 shadow-sm">
          For CA Firms
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight mb-6 leading-[1.15]">
          Your clients get instant answers about their books, <span class="text-[#25D366]">on WhatsApp.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-600 font-medium mb-8 leading-relaxed">
          AiA Bot answers your clients' money questions straight from their Tally books, in seconds. Free for your firm and free for them.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demo" class="inline-flex justify-center items-center px-8 py-4 text-lg font-bold rounded-xl text-white bg-[#25D366] hover:bg-[#1DA851] transition-all hover:scale-105 shadow-xl shadow-[#25D366]/30">
            See AiA Bot in action
          </a>
        </div>
      </div>

      <!-- CSS WhatsApp Mockup Asset -->
      <div class="relative w-full max-w-[300px] lg:max-w-[320px] mx-auto perspective-1000">
        <!-- Decoration behind phone -->
        <div class="absolute -inset-4 bg-gradient-to-r from-blue-500/20 to-emerald-400/20 rounded-full blur-2xl -z-10 animate-pulse"></div>
        
        <!-- Phone Frame -->
        <div class="bg-slate-900 rounded-[3rem] p-3 shadow-2xl ring-1 ring-slate-900/5 transform lg:rotate-y-[-10deg] lg:rotate-x-[5deg] transition-transform duration-500 hover:rotate-0">
          <div class="bg-[#EFEAE2] rounded-[2.25rem] overflow-hidden border border-slate-800 relative h-[520px] lg:h-[540px] flex flex-col">
            
            <!-- Phone Notch -->
            <div class="absolute top-0 inset-x-0 h-7 flex justify-center z-20">
              <div class="w-32 h-6 bg-slate-900 rounded-b-3xl"></div>
            </div>
            
            <!-- WhatsApp Header -->
            <div class="bg-[#075E54] text-white pt-10 pb-3 px-4 flex items-center gap-3 shadow-md z-10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center font-black text-[#075E54] shrink-0 border-2 border-white/20">
                AiA
              </div>
              <div>
                <h3 class="font-bold text-base leading-tight">AiA Bot</h3>
                <p class="text-xs text-white/80">online</p>
              </div>
            </div>

            <!-- Chat Pattern Background -->
            <div class="absolute inset-0 top-[88px] opacity-60 pointer-events-none bg-cover bg-center" style="background-image: url('/whatsapp-bg.png');"></div>
            
            <!-- Chat Area -->
            <div class="p-4 flex-1 overflow-y-auto flex flex-col gap-4 relative z-10 minimal-scrollbar">
              
              <!-- Date stamp -->
              <div class="flex justify-center mb-2">
                <span class="bg-[#E1F3FB] text-slate-600 text-[11px] px-3 py-1 rounded-lg font-medium shadow-sm">Today</span>
              </div>

              <!-- User msg -->
              <div class="flex justify-end mt-2 animate-fade-in-up">
                <div class="bg-[#D9FDD3] text-slate-800 p-3 rounded-l-xl rounded-br-xl rounded-tr-sm shadow-sm max-w-[85%] relative">
                  <p class="text-[15px] leading-snug font-medium">What's my GST this month?</p>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-500">10:42 am</span>
                    <svg class="w-3.5 h-3.5 text-[#53bdeb]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 18L7.5 13.5l1.4-1.4 3.1 3.1 8.6-8.6 1.4 1.4z"/><path d="M4 18l-4.5-4.5 1.4-1.4 3.1 3.1z"/></svg>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -right-2 top-0 w-4 h-4 text-[#D9FDD3]">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M8 0L0 0 0 13C0 13 4 8 8 0Z"/></svg>
                  </div>
                </div>
              </div>
              
              <!-- Bot msg -->
              <div class="flex justify-start animate-fade-in-up" style="animation-delay: 0.5s; animation-fill-mode: both;">
                <div class="bg-white text-slate-800 p-3 rounded-r-xl rounded-bl-xl rounded-tl-sm shadow-sm max-w-[90%] relative border border-slate-100">
                  <p class="text-[15px] leading-snug font-medium text-slate-900 mb-2">
                    Hi there! 👋 Based on your Tally books:
                  </p>
                  <p class="text-[15px] leading-snug font-medium text-slate-900 mb-2">
                    Your estimated GST liability for this month is <span class="font-bold">₹1,42,500</span>.
                  </p>
                  <p class="text-[15px] leading-snug text-slate-700">
                    Would you like a breakdown?
                  </p>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-400">10:42 am</span>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -left-2 top-0 w-4 h-4 text-white">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M0 0L8 0 8 13C8 13 4 8 0 0Z"/></svg>
                  </div>
                </div>
              </div>

            </div>

            <!-- Input Area -->
            <div class="bg-[#F0F2F5] p-2 flex items-center gap-2 z-20">
              <div class="bg-white rounded-full flex-1 flex items-center px-4 py-2.5 shadow-sm">
                <svg class="w-6 h-6 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-slate-400 text-[15px] ml-3 flex-1 whitespace-nowrap overflow-hidden">Type a message...</span>
                <svg class="w-5 h-5 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z" opacity="0.3"/><path d="M20 2H4c-1.1 0-1.99.9-1.99 2v12c0 1.1.89 2 1.99 2H18l4 4V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zm-3-5V9c0-1.1-.9-2-2-2H9c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2z"/></svg>
              </div>
              <div class="w-11 h-11 bg-[#00A884] rounded-full flex items-center justify-center text-white shadow-sm shrink-0">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z"/></svg>
              </div>
            </div>
            
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>
