---
// src/components/ca-bot/CaBotLeadForm.astro
---
<section id="demo" class="py-24 bg-white w-full border-t border-slate-200">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50 rounded-[2rem] shadow-xl p-8 sm:p-12 border border-slate-200">
      
      <div class="text-center mb-10">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#25D366]/10 text-[#25D366] mb-6">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
          Give your clients instant answers, free.
        </h2>
      </div>

      <form id="ca-bot-form" class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">Name *</label>
          <input 
            type="text" 
            id="ca_name"
            required 
            placeholder="Full Name"
            class="w-full px-5 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#25D366] focus:border-[#25D366] outline-none transition-all text-base font-medium placeholder-slate-400 bg-white"
          />
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">Firm name *</label>
          <input 
            type="text" 
            id="ca_firm_name"
            required 
            placeholder="Your CA Firm"
            class="w-full px-5 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#25D366] focus:border-[#25D366] outline-none transition-all text-base font-medium placeholder-slate-400 bg-white"
          />
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">WhatsApp number *</label>
          <div class="flex items-center">
            <span class="inline-flex items-center px-4 py-3 bg-slate-100 border border-r-0 border-slate-300 rounded-l-xl text-slate-700 text-base font-bold select-none shrink-0">
              +91
            </span>
            <input 
              type="tel" 
              id="ca_phone"
              required 
              maxlength="10"
              inputmode="numeric"
              placeholder="10-digit mobile number"
              class="w-full px-5 py-3 rounded-r-xl border border-slate-300 focus:ring-2 focus:ring-[#25D366] focus:border-[#25D366] outline-none transition-all text-base font-medium placeholder-slate-400 bg-white"
            />
          </div>
        </div>
        
        <div class="pt-4">
          <button 
            type="submit" 
            id="ca_submit"
            class="w-full bg-[#25D366] hover:bg-[#1DA851] text-white font-bold text-xl py-4 rounded-xl shadow-lg transition-all hover:-translate-y-1 shadow-[#25D366]/30"
          >
            See AiA Bot in action
          </button>
        </div>

        <div id="ca_success" class="hidden text-center py-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mb-4">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2">Request Received!</h3>
          <p class="text-slate-600 font-medium">Our team will reach out to your WhatsApp shortly to show you the demo.</p>
        </div>
      </form>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ca-bot-form') as HTMLFormElement;
    const submitBtn = document.getElementById('ca_submit') as HTMLButtonElement;
    const successMsg = document.getElementById('ca_success') as HTMLElement;

    if(form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Mock submission
        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';

        // Simulate API call
        setTimeout(() => {
          // Hide form inputs and button, show success
          const inputs = form.querySelectorAll('div:not(#ca_success):not(.inline-flex)');
          inputs.forEach((el) => {
            if((el as HTMLElement).id !== 'ca-bot-form') {
               (el as HTMLElement).style.display = 'none';
            }
          });
          successMsg.classList.remove('hidden');
        }, 1200);
      });
    }
  });
</script>
