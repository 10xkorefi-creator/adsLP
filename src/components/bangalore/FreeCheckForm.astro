---
// src/components/bangalore/FreeCheckForm.astro
---
<section id="free-check" class="py-24 bg-amber-400 w-full border-y border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-md shadow-xl p-8 sm:p-12 border border-slate-200">
      
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
          Get your free check
        </h2>
        <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto">
          Takes under a minute. We will call you and collect the documents.
        </p>
      </div>

      <form id="bangalore-restaurant-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Your Name -->
          <div>
            <label class="sr-only">Your name *</label>
            <input 
              type="text" 
              id="blr_your_name"
              name="first_name"
              required 
              placeholder="Your name *"
              class="w-full px-5 py-3 rounded border border-slate-300 focus:ring-4 focus:ring-amber-400 focus:border-slate-900 outline-none transition-all text-base font-bold placeholder-slate-500 text-slate-900"
            />
          </div>

          <!-- Phone Number -->
          <div>
            <label class="sr-only">Phone number *</label>
            <div class="flex items-center">
              <span class="inline-flex items-center px-4 py-3 bg-slate-100 border-2 border-r-0 border-slate-900 rounded-l text-slate-900 text-base font-black select-none shrink-0">
                +91
              </span>
              <input 
                type="tel" 
                id="blr_phone"
                name="lg__phone"
                required 
                maxlength="10"
                inputmode="numeric"
                placeholder="Phone number *"
                class="w-full px-5 py-3 rounded-r border border-slate-300 focus:ring-4 focus:ring-amber-400 focus:border-slate-900 outline-none transition-all text-base font-bold placeholder-slate-500 text-slate-900"
              />
            </div>
            <p class="text-xs text-slate-500 mt-2 font-medium">We will call within one working day.</p>
          </div>

          <!-- Restaurant Name -->
          <div>
            <label class="sr-only">Restaurant name *</label>
            <input 
              type="text" 
              id="blr_restaurant_name"
              name="company"
              required 
              placeholder="Restaurant name *"
              class="w-full px-5 py-3 rounded border border-slate-300 focus:ring-4 focus:ring-amber-400 focus:border-slate-900 outline-none transition-all text-base font-bold placeholder-slate-500 text-slate-900"
            />
          </div>

          <!-- Outlets -->
          <div>
            <label class="sr-only">How many outlets? *</label>
            <select 
              id="blr_outlets"
              name="number_of_outlets"
              required
              class="w-full px-5 py-3 rounded border border-slate-300 focus:ring-4 focus:ring-amber-400 focus:border-slate-900 outline-none transition-all text-base font-bold cursor-pointer bg-white text-slate-900"
            >
              <option value="" disabled selected>How many outlets? *</option>
              <option value="1">1</option>
              <option value="2 to 3">2 to 3</option>
              <option value="4 to 5">4 to 5</option>
              <option value="6 or more">6 or more</option>
            </select>
          </div>

          <!-- Online orders per day -->
          <div class="md:col-span-2">
            <label class="sr-only">Online orders per day, all outlets together? *</label>
            <select 
              id="blr_online_orders"
              name="online_orders_per_day"
              required
              class="w-full px-5 py-3 rounded border border-slate-300 focus:ring-4 focus:ring-amber-400 focus:border-slate-900 outline-none transition-all text-base font-bold cursor-pointer bg-white text-slate-900"
            >
              <option value="" disabled selected>Online orders per day, all outlets together? *</option>
              <option value="We don't sell online">We don't sell online</option>
              <option value="Under 30">Under 30</option>
              <option value="30 to 100">30 to 100</option>
              <option value="100 to 300">100 to 300</option>
              <option value="More than 300">More than 300</option>
            </select>
          </div>
          
        </div>

        <div class="mt-8">
          <button 
            type="submit" 
            id="blr_submit"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xl py-4 rounded border border-slate-200 shadow-lg transition-transform hover:-translate-y-1"
          >
            Send me my free check
          </button>
          <p class="text-center text-slate-500 font-medium text-sm mt-4">
            We take 20 restaurants at a time. No payment, no commitment.
          </p>
        </div>

        <div id="blr_success" class="hidden text-center py-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 text-emerald-500 mb-4">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2">Thank you!</h3>
          <p class="text-slate-600 font-medium">We will call you within one working day.</p>
        </div>

      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('bangalore-restaurant-form') as HTMLFormElement;
    const submitBtn = document.getElementById('blr_submit') as HTMLButtonElement;
    const successMsg = document.getElementById('blr_success') as HTMLElement;
    const webhookUrl = "https://n8n.aiaccountant.com/webhook/ce246056-bdd0-4199-b363-3b44ed255f96";

    if(form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        
        // Add additional attribution details
        payload.contact_source = "VA Bangalore restaurants";
        payload.__page = window.location.href;
        payload.__event = "form_submit_bangalore_restaurant";
        
        console.log("Submitting payload to n8n:", payload);

        try {
          await fetch(webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          // Hide form inputs and button, show success
          const inputs = form.querySelectorAll('div.grid, div.mt-8');
          inputs.forEach((el) => {
            (el as HTMLElement).style.display = 'none';
          });
          successMsg.classList.remove('hidden');
        } catch (error) {
          console.error("Error submitting form:", error);
          submitBtn.textContent = 'Send me my free check';
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
          alert('Something went wrong. Please try again.');
        }
      });
    }
  });
</script>
