---
// src/components/campaigns/HowItWorks.astro
---
<section class="py-16 lg:py-24 bg-white relative" id="how-it-works">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        From documents to done in <span class="text-purple-600">4 steps</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
      
      <!-- Step 1 -->
      <div class="relative flex flex-col items-center text-center group">
        <div class="w-16 h-16 rounded-full bg-purple-100 text-purple-700 text-2xl font-black flex items-center justify-center mb-6 shadow-sm border-4 border-white z-10 group-hover:bg-purple-600 group-hover:text-white transition-colors duration-300">
          1
        </div>
        <!-- Connector Line (Desktop) -->
        <div class="hidden lg:block absolute top-8 left-[60%] w-full h-[2px] bg-slate-100"></div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">Connect your TallyPrime</h3>
        <p class="text-slate-600 font-medium leading-relaxed">
          We connect to your current data safely. No migration and no disruption.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative flex flex-col items-center text-center group">
        <div class="w-16 h-16 rounded-full bg-purple-100 text-purple-700 text-2xl font-black flex items-center justify-center mb-6 shadow-sm border-4 border-white z-10 group-hover:bg-purple-600 group-hover:text-white transition-colors duration-300">
          2
        </div>
        <!-- Connector Line (Desktop) -->
        <div class="hidden lg:block absolute top-8 left-[60%] w-full h-[2px] bg-slate-100"></div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">Send your documents</h3>
        <p class="text-slate-600 font-medium leading-relaxed">
          Upload or forward your bank statements, bills, and invoices.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="relative flex flex-col items-center text-center group">
        <div class="w-16 h-16 rounded-full bg-purple-100 text-purple-700 text-2xl font-black flex items-center justify-center mb-6 shadow-sm border-4 border-white z-10 group-hover:bg-purple-600 group-hover:text-white transition-colors duration-300">
          3
        </div>
        <!-- Connector Line (Desktop) -->
        <div class="hidden lg:block absolute top-8 left-[60%] w-full h-[2px] bg-slate-100"></div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">AI Accountant posts the entries</h3>
        <p class="text-slate-600 font-medium leading-relaxed">
          Sorted, GST-tagged, and ready for you to check.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="relative flex flex-col items-center text-center group">
        <div class="w-16 h-16 rounded-full bg-purple-100 text-purple-700 text-2xl font-black flex items-center justify-center mb-6 shadow-sm border-4 border-white z-10 group-hover:bg-purple-600 group-hover:text-white transition-colors duration-300">
          4
        </div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">You review and approve</h3>
        <p class="text-slate-600 font-medium leading-relaxed">
          You stay in control. Nothing goes into your books without your okay.
        </p>
      </div>

    </div>
  </div>
</section>
