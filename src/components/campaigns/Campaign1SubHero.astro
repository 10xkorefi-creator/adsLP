---
// Campaign1SubHero.astro
---
<section class="py-10 bg-slate-900 border-b border-slate-800 relative z-20 shadow-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-center md:justify-between gap-6 md:gap-4 text-center md:text-left">
      
      <!-- Step 1 -->
      <div class="flex flex-col items-center md:flex-row md:items-start gap-4 flex-1">
        <div class="w-10 h-10 rounded-full bg-slate-800 text-slate-300 font-bold flex items-center justify-center shrink-0 border border-slate-700">
          1
        </div>
        <div>
          <h4 class="text-white font-bold text-lg">Send us your Tally</h4>
          <p class="text-slate-400 text-sm mt-1">File or remote access</p>
        </div>
      </div>
      
      <!-- Arrow -->
      <div class="hidden md:block shrink-0 text-slate-600">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
      
      <!-- Step 2 -->
      <div class="flex flex-col items-center md:flex-row md:items-start gap-4 flex-1 justify-center md:justify-start">
        <div class="w-10 h-10 rounded-full bg-slate-800 text-slate-300 font-bold flex items-center justify-center shrink-0 border border-slate-700">
          2
        </div>
        <div>
          <h4 class="text-white font-bold text-lg">Our CA team reviews</h4>
          <p class="text-slate-400 text-sm mt-1">Deep analysis of books</p>
        </div>
      </div>
      
      <!-- Arrow -->
      <div class="hidden md:block shrink-0 text-slate-600">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-col items-center md:flex-row md:items-start gap-4 flex-1 justify-center md:justify-start">
        <div class="w-10 h-10 rounded-full bg-tally-900 text-tally-400 font-bold flex items-center justify-center shrink-0 border border-tally-800 shadow-[0_0_15px_rgba(16,185,129,0.3)]">
          3
        </div>
        <div>
          <h4 class="text-white font-bold text-lg">Get score & report</h4>
          <p class="text-tally-400 font-medium text-sm mt-1">In 48 hours. Free.</p>
        </div>
      </div>

    </div>
  </div>
</section>
