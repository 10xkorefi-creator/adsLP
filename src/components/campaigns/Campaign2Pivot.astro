<section class="py-16 md:py-24 bg-white relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-8">
      The only way to know if you're exposed is to reconcile the two. <br class="hidden md:block" />
      <span class="text-tally-600">That starts with a look at your books.</span>
    </h2>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#hero-form" class="w-full sm:w-auto inline-flex items-center justify-center bg-tally-600 hover:bg-tally-700 text-white font-bold text-lg px-8 py-4 rounded-xl shadow-lg transition-all hover:-translate-y-1 shadow-tally-600/30">
        Get your free books health check
      </a>
    </div>
    
  </div>
</section>
