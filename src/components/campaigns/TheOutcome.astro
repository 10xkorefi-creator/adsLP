---
// src/components/campaigns/TheOutcome.astro
---
<section class="py-16 lg:py-24 bg-purple-600 relative overflow-hidden" id="the-outcome">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 opacity-10">
    <svg class="absolute left-0 top-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M0 100 C 20 0 50 0 100 100 Z" fill="currentColor"></path>
    </svg>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center bg-purple-700/30 backdrop-blur-sm rounded-3xl p-8 sm:p-12 border border-purple-400/20 shadow-2xl">
      <div class="w-16 h-16 mx-auto bg-purple-500/30 text-purple-100 rounded-full flex items-center justify-center mb-6">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
      </div>
      
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Imagine month-end <span class="text-purple-200 border-b-4 border-purple-400">without the stress</span>
      </h2>
      
      <p class="text-lg sm:text-xl md:text-2xl text-purple-50 font-medium leading-relaxed max-w-2xl mx-auto">
        Your books stay up to date. Entries are posted as documents come in. You can see your cash, receivables, and payables any day of the month — not just at year-end.
      </p>
    </div>
  </div>
</section>
