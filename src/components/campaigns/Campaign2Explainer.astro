---
// Campaign2Explainer.astro
---

<section class="py-16 md:py-24 bg-slate-50 border-y border-slate-200 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Hiring an accountant? <span class="text-tally-600">Get a finance team instead.</span>
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        A CA-led team gives you more coverage, without one-person dependency or the cost of a full-time hire.
      </p>
    </div>

    <div class="flex flex-col md:flex-row items-stretch justify-center gap-8 md:gap-12">
      
      <!-- One Hire (The Problem) -->
      <div class="flex-1 bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
        <div class="bg-slate-100 py-4 px-6 border-b border-slate-200 text-center">
          <span class="inline-block px-4 py-1.5 bg-slate-200 text-slate-700 font-bold text-sm rounded-full tracking-wide">
            ONE HIRE
          </span>
        </div>
        <div class="p-8 md:p-10 flex-1 flex flex-col items-center">
          <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-400">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-6">Accountant</h3>
          
          <div class="w-full bg-slate-50 rounded-xl p-6 border border-slate-100 space-y-4 relative">
            <div class="absolute -right-3 -top-3 w-8 h-8 bg-red-100 text-red-600 rounded-full flex items-center justify-center border-2 border-white font-bold shadow-sm">!</div>
            <div class="flex items-center gap-4 text-slate-700 font-medium">
              <span class="inline-flex items-center justify-center w-6 h-6 text-red-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              </span>
              Books
            </div>
            <div class="flex items-center gap-4 text-slate-700 font-medium">
              <span class="inline-flex items-center justify-center w-6 h-6 text-red-400 font-bold text-lg">%</span>
              GST
            </div>
            <div class="flex items-center gap-4 text-slate-700 font-medium">
              <span class="inline-flex items-center justify-center w-6 h-6 text-red-400 font-bold text-lg">₹</span>
              TDS
            </div>
            <div class="flex items-center gap-4 text-slate-700 font-medium">
              <span class="inline-flex items-center justify-center w-6 h-6 text-red-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
              </span>
              Filings
            </div>
            <div class="flex items-center gap-4 text-slate-700 font-medium">
              <span class="inline-flex items-center justify-center w-6 h-6 text-red-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
              </span>
              MIS
            </div>
          </div>
          
          <div class="mt-8 pt-6 border-t border-slate-100 w-full flex items-center justify-center gap-2 text-red-600 font-semibold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            Single point of failure
          </div>
        </div>
      </div>
      
      <!-- VS Badge -->
      <div class="hidden md:flex flex-col items-center justify-center -mx-4 z-20">
        <div class="w-12 h-12 bg-white rounded-full shadow-md border border-slate-100 flex items-center justify-center font-black text-slate-400">
          VS
        </div>
      </div>
      
      <!-- Team (The Solution) -->
      <div class="flex-1 bg-white rounded-3xl shadow-xl shadow-tally-900/5 border-2 border-tally-500 overflow-hidden flex flex-col relative transform transition-transform hover:-translate-y-1">
        <div class="absolute top-0 right-0 w-32 h-32 bg-tally-50 rounded-bl-full -z-10"></div>
        <div class="bg-tally-50 py-4 px-6 border-b border-tally-100 text-center flex items-center justify-center gap-2">
          <span class="inline-block px-4 py-1.5 bg-tally-600 text-white font-bold text-sm rounded-full tracking-wide">
            CA-LED & AI TRAINED TEAM
          </span>
          <svg class="w-6 h-6 text-tally-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
        </div>
        
        <div class="p-8 md:p-10 flex-1 flex flex-col items-center">
          
          <div class="flex flex-col items-center relative z-10 bg-white px-4">
            <div class="w-20 h-20 bg-tally-100 rounded-full flex items-center justify-center text-tally-700 mb-2 border-4 border-white shadow-sm">
              <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              <div class="absolute bottom-6 right-2 bg-white text-tally-600 text-xs font-black px-2 py-0.5 rounded shadow-sm border border-slate-100">CA</div>
            </div>
            <p class="font-bold text-slate-900 text-sm">Team Lead</p>
          </div>
          
          <div class="relative w-full flex flex-col items-center mt-2">
            <!-- Hierarchy lines using standard CSS borders for robustness -->
            <div class="w-0.5 h-6 bg-slate-200"></div>
            <div class="w-3/4 border-t-2 border-slate-200 flex justify-between">
              <div class="w-0.5 h-4 bg-slate-200"></div>
              <div class="w-0.5 h-4 bg-slate-200"></div>
              <div class="w-0.5 h-4 bg-slate-200"></div>
            </div>
            
            <div class="flex w-full justify-between -mt-1 px-4">
              <div class="flex flex-col items-center flex-1">
                <div class="w-14 h-14 bg-indigo-50 rounded-full flex items-center justify-center text-indigo-500 mb-2 border-2 border-white shadow-sm z-10">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <p class="text-[10px] sm:text-xs font-bold text-slate-700 text-center uppercase tracking-wide leading-tight">Financial<br/>Reporting</p>
              </div>
              <div class="flex flex-col items-center flex-1">
                <div class="w-14 h-14 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 mb-2 border-2 border-white shadow-sm z-10">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <p class="text-[10px] sm:text-xs font-bold text-slate-700 text-center uppercase tracking-wide leading-tight">Tax &<br/>Compliance</p>
              </div>
              <div class="flex flex-col items-center flex-1">
                <div class="w-14 h-14 bg-amber-50 rounded-full flex items-center justify-center text-amber-500 mb-2 border-2 border-white shadow-sm z-10">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <p class="text-[10px] sm:text-xs font-bold text-slate-700 text-center uppercase tracking-wide leading-tight">FP&A<br/>& Insights</p>
              </div>
            </div>
          </div>
          
          <div class="mt-8 pt-6 border-t border-slate-100 w-full flex flex-wrap justify-center gap-x-4 gap-y-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-600">
              <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              Built-in backup
            </div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-600">
              <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
              Continuity assured
            </div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-600">
              <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
              Stronger outcomes
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
</section>
