---
// Campaign1Hero.astro
---

<header
  class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 bg-slate-50 overflow-hidden"
  id="hero"
>
  <!-- Subtle background glow -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-[400px] bg-tally-500/10 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Content -->
      <div class="text-center lg:text-left">
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-100 text-orange-700 font-bold text-sm mb-6 border border-orange-200"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Audit season is a few weeks away
        </div>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-tight mb-6"
        >
          How audit-ready <br class="hidden lg:block" /> are your books?
        </h1>

        <p
          class="text-lg sm:text-xl text-slate-600 mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed"
        >
          Get a free books health check from our CA-led team. We score your
          books, flag any risks, and hand you a one-page report in 48 hours.
        </p>

        <div
          class="flex flex-wrap items-center justify-center lg:justify-start gap-x-4 gap-y-2 text-sm font-medium text-slate-500"
        >
          <span class="flex items-center gap-1.5 text-slate-700">
            <svg
              class="w-4 h-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            CA-led
          </span>
          <span class="hidden sm:inline">•</span>
          <span class="flex items-center gap-1.5 text-slate-700">
            <svg
              class="w-4 h-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            300+ businesses
          </span>
          <span class="hidden sm:inline">•</span>
          <span class="flex items-center gap-1.5 text-slate-700">
            <svg
              class="w-4 h-4 text-emerald-500"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Your Tally data stays in India
          </span>
        </div>
      </div>

      <!-- Right Visual (Mockup) -->
      <div class="relative w-full max-w-lg mx-auto lg:max-w-none">
        <!-- Floating Elements Background -->
        <div
          class="absolute inset-0 bg-gradient-to-tr from-tally-100 to-indigo-50 rounded-[2rem] transform rotate-3 scale-105 opacity-50"
        >
        </div>

        <div
          class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 sm:p-8 transform transition-transform hover:-translate-y-1 duration-300"
          id="hero-form"
        >
          <!-- Form Header -->
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-slate-900 mb-2">
              Request Health Check
            </h3>
            <p class="text-sm text-slate-500">
              Fill details below and our CA team will connect within 2 hours.
            </p>
          </div>

          <!-- Lead Form -->
          <form id="campaign1-form" class="space-y-4">
            <div>
              <label
                for="c1-name"
                class="block text-sm font-semibold text-slate-700 mb-1"
                >Name</label
              >
              <input
                type="text"
                id="c1-name"
                name="name"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-tally-500 focus:border-tally-500 outline-none transition-all"
                placeholder="Enter your name"
              />
              <span id="c1-name-error" class="hidden text-red-600 text-xs mt-1"
                >Please enter your name.</span
              >
            </div>
            <div>
              <label
                for="c1-email"
                class="block text-sm font-semibold text-slate-700 mb-1"
                >Work Email</label
              >
              <input
                type="email"
                id="c1-email"
                name="email"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-tally-500 focus:border-tally-500 outline-none transition-all"
                placeholder="founder@company.com"
              />
              <span id="c1-email-error" class="hidden text-red-600 text-xs mt-1"
                >Please enter a valid email.</span
              >
            </div>
            <div>
              <label
                for="c1-phone"
                class="block text-sm font-semibold text-slate-700 mb-1"
                >Phone Number</label
              >
              <input
                type="tel"
                id="c1-phone"
                name="phone"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-tally-500 focus:border-tally-500 outline-none transition-all"
                placeholder="98765 43210"
              />
              <span id="c1-phone-error" class="hidden text-red-600 text-xs mt-1"
                >Please enter a valid 10-digit phone number.</span
              >
            </div>
            <button
              type="submit"
              id="c1-submit"
              class="w-full bg-tally-600 hover:bg-tally-700 text-white font-bold py-3.5 rounded-lg shadow-md transition-all hover:scale-[1.02] mt-4"
            >
              Get My Free Health Check
            </button>
            <p class="text-xs text-center text-slate-500 mt-3">
              We respect your privacy. No spam.
            </p>
          </form>

          <!-- Mockup visual overlaid at bottom corner -->
        </div>
      </div>
    </div>
  </div>
</header>

<script
  type="text/javascript"
  src="https://assets.revenuehero.io/scheduler.min.js"></script>
<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("campaign1-form");
    const nameInput = document.getElementById("c1-name");
    const emailInput = document.getElementById("c1-email");
    const phoneInput = document.getElementById("c1-phone");
    const btn = document.getElementById("c1-submit");

    // Phone format
    phoneInput.addEventListener("input", () => {
      phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
    });

    const showError = (id, show) => {
      const el = document.getElementById(id);
      const err = document.getElementById(`${id}-error`);
      if (show) {
        el.style.borderColor = "#dc2626";
        err.classList.remove("hidden");
      } else {
        el.style.borderColor = "";
        err.classList.add("hidden");
      }
    };

    [nameInput, emailInput, phoneInput].forEach((el) => {
      el.addEventListener("input", () => showError(el.id, false));
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const phone = phoneInput.value.trim();
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      let isValid = true;
      let firstBad = null;

      if (phone.length !== 10) {
        isValid = false;
        showError("c1-phone", true);
        firstBad = firstBad || phoneInput;
      }
      if (!email || !emailRe.test(email)) {
        isValid = false;
        showError("c1-email", true);
        firstBad = firstBad || emailInput;
      }
      if (!name) {
        isValid = false;
        showError("c1-name", true);
        firstBad = firstBad || nameInput;
      }

      if (!isValid) {
        if (firstBad) firstBad.focus();
        return;
      }

      // RH snippet logic using the proven submit & dialog.open API
      btn.textContent = "Scheduling...";
      btn.style.opacity = "0.7";

      const payload = {
        first_name: name,
        email: email,
        lg__phone: phone, // standard phone field from leadForm.ts
        campaign: "virtual-accounting-GAds", // passing the slug as context
        contact_source: "va-health-check",
      };

      // Gather attribution parameters (matches /tally-automation logic)
      const params = new URLSearchParams(window.location.search);
      const CLICK_ID_MAP = {
        gclid: "hs_google_click_id",
        fbclid: "hs_facebook_click_id",
        li_fat_id: "hs_linkedin_click_id",
      };
      const UTM_PARAMS = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_term",
        "utm_content",
        "placements",
        "utm_device",
        "gclid",
      ];

      const clickIdStorageKey = "__clickids";
      let storedClickIds = {};
      try {
        storedClickIds = JSON.parse(
          sessionStorage.getItem(clickIdStorageKey) || "{}",
        );
      } catch (e) {}

      Object.entries(CLICK_ID_MAP).forEach(([urlParam, hsInputName]) => {
        const fromUrl = params.get(urlParam);
        if (fromUrl) {
          storedClickIds[hsInputName] = fromUrl;
          payload[hsInputName] = fromUrl;
        } else if (storedClickIds[hsInputName]) {
          payload[hsInputName] = storedClickIds[hsInputName];
        }
      });
      try {
        sessionStorage.setItem(
          clickIdStorageKey,
          JSON.stringify(storedClickIds),
        );
      } catch (e) {}

      UTM_PARAMS.forEach((param) => {
        const value = params.get(param);
        if (value) payload[param] = value;
      });

      try {
        if (!window.RevenueHero) {
          throw new Error("RevenueHero script not loaded yet");
        }

        const hero = new window.RevenueHero({ routerId: "5434" });

        hero
          .submit(payload)
          .then((sessionData) => {
            if (sessionData) {
              hero.dialog.open(sessionData);
            } else {
              console.error("No session data returned from RH");
            }
            // Reset btn after a short delay
            setTimeout(() => {
              btn.textContent = "Get Started For Free";
              btn.style.opacity = "1";
            }, 2000);
          })
          .catch((err) => {
            console.error("RH Submit Error:", err);
            btn.textContent = "Get Started For Free";
            btn.style.opacity = "1";
          });
      } catch (err) {
        console.error("RH Error:", err);
        btn.textContent = "Get Started For Free";
        btn.style.opacity = "1";
      }
    });
  });
</script>
