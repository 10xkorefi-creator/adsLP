---
const faqs = [
  {
    question: "What is a books health check?",
    answer: "A CA-led review of your books that scores audit-readiness and flags risks like GST↔ITR mismatches. You get a one-page report in 48 hours, free, no obligation."
  },
  {
    question: "What do I need to share?",
    answer: "Your Tally file or Tally access. Your data stays in India, on encrypted infrastructure. We sign an NDA before you share anything."
  },
  {
    question: "Is it really free?",
    answer: "Yes. The health check and report are free. If you want us to run your books after, that's a separate paid engagement, no pressure to take it."
  },
  {
    question: "How is this different from my current accountant?",
    answer: "Your accountant maintains the books. This is an independent second look that scores audit-readiness and catches gaps a single set of eyes can miss."
  },
  {
    question: "What happens after I get the report?",
    answer: "You may choose to: Fix it yourself, take it to your accountant, or have our CA-led team handle it."
  }
];
---

<section class="py-20 bg-slate-50 relative border-t border-slate-200">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200 hover:border-tally-200">
          <button 
            class="faq-button flex items-center justify-between w-full p-6 text-left focus:outline-none focus-visible:ring focus-visible:ring-tally-500 focus-visible:ring-opacity-50"
            aria-expanded="false"
          >
            <span class="text-lg font-bold text-slate-900">{faq.question}</span>
            <span class="ml-6 flex-shrink-0 text-slate-400">
              <svg class="faq-icon w-6 h-6 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          
          <div class="faq-content px-6 text-slate-600 leading-relaxed overflow-hidden transition-all duration-300 max-h-0">
            <div class="pb-6">
              <p>{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const button = item.querySelector('.faq-button');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      
      if (!button || !content || !icon) return;
      
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0px';
          icon.classList.remove('rotate-180');
        } else {
          // Close all others first
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              const otherBtn = otherItem.querySelector('.faq-button');
              const otherContent = otherItem.querySelector('.faq-content');
              const otherIcon = otherItem.querySelector('.faq-icon');
              if (otherBtn && otherContent && otherIcon) {
                otherBtn.setAttribute('aria-expanded', 'false');
                otherContent.style.maxHeight = '0px';
                otherIcon.classList.remove('rotate-180');
              }
            }
          });
          
          button.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + "px";
          icon.classList.add('rotate-180');
        }
      });
    });
  });
</script>
