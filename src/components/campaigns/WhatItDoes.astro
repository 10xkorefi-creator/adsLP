---
// src/components/campaigns/WhatItDoes.astro
---
<section class="py-16 lg:py-24 bg-slate-50 relative border-t border-slate-200/60" id="what-it-does">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        What AI Accountant does <span class="text-purple-600">inside Tally</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Card 1 -->
      <article class="bg-white rounded-2xl p-8 lg:p-10 shadow-sm border border-slate-200/70 hover:shadow-xl hover:border-purple-200 transition-all duration-300 flex flex-col items-start group">
        <div class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center text-purple-600 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-3 tracking-tight">Bank statements → Tally</h3>
        <p class="text-slate-600 text-base sm:text-lg font-medium leading-relaxed">
          Upload any bank statement — PDF or Excel. AI Accountant turns it into sorted vouchers and posts them into Tally. No typing needed.
        </p>
      </article>

      <!-- Card 2 -->
      <article class="bg-white rounded-2xl p-8 lg:p-10 shadow-sm border border-slate-200/70 hover:shadow-xl hover:border-purple-200 transition-all duration-300 flex flex-col items-start group">
        <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-3 tracking-tight">Bills and invoices, captured for you</h3>
        <p class="text-slate-600 text-base sm:text-lg font-medium leading-relaxed">
          Forward or take a photo of a purchase bill. Line items, GST, and ledgers are read and entered for you.
        </p>
      </article>

      <!-- Card 3 -->
      <article class="bg-white rounded-2xl p-8 lg:p-10 shadow-sm border border-slate-200/70 hover:shadow-xl hover:border-purple-200 transition-all duration-300 flex flex-col items-start group">
        <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-3 tracking-tight">GST reconciliation</h3>
        <p class="text-slate-600 text-base sm:text-lg font-medium leading-relaxed">
          Match your books with GSTR-2B, spot mismatches, and find Input Tax Credit you might otherwise miss.
        </p>
      </article>

      <!-- Card 4 -->
      <article class="bg-white rounded-2xl p-8 lg:p-10 shadow-sm border border-slate-200/70 hover:shadow-xl hover:border-purple-200 transition-all duration-300 flex flex-col items-start group">
        <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600 mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-3 tracking-tight">Live AP/AR dashboard</h3>
        <p class="text-slate-600 text-base sm:text-lg font-medium leading-relaxed">
          See your receivables, payables, and cash position in real time. No waiting for month-end.
        </p>
      </article>

    </div>
  </div>
</section>
