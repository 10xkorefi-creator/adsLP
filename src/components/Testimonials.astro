<!-- Section 3: Testimonials Grid (Exact Copy & Styling from Image) -->
<section class="py-16 md:py-24 bg-purple-50/60" id="tally-reviews">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-2"
      >
        Real Results, <span class="text-purple-600">Real Success</span>
      </h2>
      <p class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Hear from Our Clients
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        testimonials.map((item) => (
          <article class="bg-[#E6E6E6] border border-slate-300/60 rounded-2xl p-7 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <p class="text-slate-700 font-medium text-sm sm:text-base leading-relaxed mb-6">
              "{item.quote}"
            </p>
            <div class="pt-4 border-t border-slate-300/70 mt-auto flex flex-col items-start gap-2.5">
              {item.logo ? (
                <img
                  src={item.logo}
                  alt={item.author}
                  loading="lazy"
                  decoding="async"
                  width="130"
                  height="32"
                  class="h-8 max-w-[130px] object-contain object-left mb-0.5"
                />
              ) : (
                <div class="w-9 h-9 rounded-full bg-slate-900 text-white font-bold text-sm flex items-center justify-center shrink-0 mb-0.5">
                  {item.icon}
                </div>
              )}
              <div>
                <h3 class="font-bold text-slate-900 text-base leading-snug">
                  {item.author}
                </h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">
                  {item.role}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
