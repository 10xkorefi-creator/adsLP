---
// Test variant C: warm "offer" hero — marker-highlighted headline, bold card, amber CTA.
---

<header
  class="relative pt-4 pb-10 lg:pt-10 lg:pb-16 bg-gradient-to-b from-amber-50 via-white to-white overflow-hidden"
  id="hero"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-14 items-start">
      <!-- Headline column -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.08] lg:leading-[1.1] tracking-tighter mb-3 lg:mb-6 text-slate-950 text-center lg:text-left"
        >
          <span class="relative inline-block block">
            <span
              class="absolute inset-x-0 bottom-1 h-[45%] bg-amber-300/80 -rotate-1 rounded-sm"
              aria-hidden="true"></span>
            <span class="relative">3 days left</span>
          </span>
          <span class="inline lg:block mt-1 lg:mt-4">
            to get
          </span>
          <span class="inline lg:block lg:mt-5">
            <span
              class="inline-block bg-red-600 text-white px-2 sm:px-3 rounded-lg -rotate-1"
              >40% off*</span
            >
          </span>
        </h1>

        <p
          class="hidden lg:block text-lg text-slate-600 font-normal leading-relaxed mb-6 max-w-xl"
        >
          Effortlessly integrate with Tally using our AI Accountant to
          streamline workflows, reduce manual errors, and gain real-time
          financial insights – empowering you to focus on growth and smarter
          decisions.
        </p>

        <div
          class="hidden lg:flex text-sm font-medium text-slate-500 tracking-wide flex-wrap items-center gap-x-2 gap-y-1"
        >
          <span>ISO Certified</span>
          <span class="text-slate-300">•</span>
          <span>SOC 2 Type II Certified</span>
          <span class="text-slate-300">•</span>
          <span>300M+ Transactions Analyzed</span>
        </div>
      </div>

      <!-- Form column -->
      <div class="lg:col-span-6" id="lead-form-container">
        <div
          class="bg-white border-2 border-slate-950 rounded-xl p-4 sm:p-6 shadow-[6px_6px_0_0_rgba(15,23,42,1)] relative"
        >
          <div
            class="flex items-center justify-between gap-2 mb-3 lg:mb-4 pb-2.5 lg:pb-3 border-b-2 border-slate-100"
          >
            <h2
              class="text-lg sm:text-xl lg:text-2xl font-black text-slate-950 tracking-tight"
            >
              Book A Demo
            </h2>
            <span
              class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 text-xs font-bold px-2.5 py-1 rounded-full border border-amber-300"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"
              ></span>
              40 slots available
            </span>
          </div>

          <form id="vcLeadForm" class="space-y-2.5 lg:space-y-3" novalidate>
            <div>
              <input
                type="text"
                id="vc-first_name"
                name="first_name"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-lg text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-500 focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all"
                placeholder="Name *"
                required
              />
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-first_name-error">Please enter your name</span
              >
            </div>

            <div>
              <input
                type="email"
                id="vc-email"
                name="email"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-lg text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-500 focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all"
                placeholder="Email Address *"
                required
              />
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-email-error">Please enter a valid email address</span
              >
            </div>

            <div>
              <div class="flex items-center">
                <span
                  class="inline-flex items-center px-3.5 h-11 sm:h-12 bg-amber-50 border-2 border-r-0 border-slate-200 rounded-l-lg text-slate-700 text-sm lg:text-base font-bold select-none shrink-0"
                >
                  +91
                </span>
                <input
                  type="tel"
                  id="vc-lg__phone"
                  name="lg__phone"
                  maxlength="10"
                  inputmode="numeric"
                  class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-r-lg text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-500 focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all"
                  placeholder="Phone number *"
                  required
                />
              </div>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-lg__phone-error"
                >Phone number must be exactly 10 digits</span
              >
            </div>

            <div>
              <select
                id="vc-which_accounting_tool_do_you_use"
                name="which_accounting_tool_do_you_use"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-lg text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected
                  >Which accounting tool do you use? *</option
                >
                <option value="Tally">Tally</option>
                <option value="Both">Both</option>
                <option value="Zoho Books">Zoho Books</option>
                <option value="Others">Others</option>
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-which_accounting_tool_do_you_use-error"
                >Please select your accounting tool</span
              >
            </div>

            <div>
              <select
                id="vc-accounting_team_size"
                name="accounting_team_size"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-lg text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected>Team size *</option>
                <option value="0">0</option>
                <option value="1-3">1-3</option>
                <option value="3-5">3-5</option>
                <option value="5-10">5-10</option>
                <option value="10+">10+</option>
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-accounting_team_size-error"
                >Please select team size</span
              >
            </div>

            <div>
              <select
                id="vc-which_best_describes_you"
                name="which_best_describes_you"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border-2 border-slate-200 rounded-lg text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-slate-950 focus:ring-2 focus:ring-amber-300 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected
                  >Which best describes you? *</option
                >
                <option value="CA firm: automating my clients' books"
                  >CA firm: automating my clients' books</option
                >
                <option
                  value="Business owner: automating my company's accounting"
                  >Business owner: automating my company's accounting</option
                >
                <option value="Finance team: looking to automate our books"
                  >Finance team: looking to automate our books</option
                >
                <option value="Channel partner: looking to resell AiA"
                  >Channel partner: looking to resell AiA</option
                >
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vc-which_best_describes_you-error"
                >Please select your role</span
              >
            </div>

            <button
              type="submit"
              id="Tally-Automation"
              class="w-full h-12 sm:h-13 mt-1.5 lg:mt-2 bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-slate-950 font-black text-base lg:text-lg rounded-lg border-2 border-slate-950 shadow-[3px_3px_0_0_rgba(15,23,42,1)] hover:shadow-[1px_1px_0_0_rgba(15,23,42,1)] hover:translate-x-[2px] hover:translate-y-[2px] transition-all cursor-pointer flex items-center justify-center tracking-wide"
            >
              Submit
            </button>
            <span
              id="vc-general-error"
              class="text-xs font-semibold text-[#dc2626] hidden mt-2 text-center block"
            >
              Couldn't save your details. Please try again.
            </span>

            <p
              class="text-[10px] sm:text-xs text-slate-500 text-center pt-1 lg:pt-2 leading-tight font-medium"
            >
              By submitting this form, you agree to our <a
                href="https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/6a44d5f5042f7ab8d58990ad_Privacy%20Policy_AIA_6.0_300626%20%201%20(1).pdf"
                target="_blank"
                rel="noopener"
                class="text-purple-700 font-bold underline hover:text-purple-900"
                >Privacy Policy</a
              > and consent to being contacted.
            </p>
          </form>

          <div id="vcSuccessMessage" class="hidden text-center py-6">
            <div
              class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full inline-flex items-center justify-center mb-2"
            >
              <svg
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </div>
            <h3 class="text-lg font-black text-slate-950 mb-1">
              You're All Set!
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm font-semibold">
              Thank you for requesting a demo. Our team will contact you
              shortly.
            </p>
          </div>
        </div>

        <!-- Compact mobile trust strip -->
        <div
          class="lg:hidden flex justify-center flex-wrap items-center gap-x-2 gap-y-1 mt-3 text-[10px] font-semibold text-slate-500 tracking-wide"
        >
          <span>ISO Certified</span>
          <span class="text-slate-300">•</span>
          <span>SOC 2 Type II Certified</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-800">300M+ Transactions Analyzed</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { bindLeadForm } from "../scripts/leadForm";

  bindLeadForm({
    contactSource: "Tally Automation",
    defaultRouterId: "6506",
    channelPartnerRouterId: "6273",
    triggerSelector: "#Tally-Automation",
    webhookUrl:
      "https://aiacc.app.n8n.cloud/webhook/ce246056-bdd0-4199-b363-3b44ed255f96",
    blockedTools: ["Zoho Books", "Others"],
    webhookOnAllPaths: false,
    debug: true,

    formSelector: "#vcLeadForm",
    fieldIdPrefix: "vc-",
    successSelector: "#vcSuccessMessage",
    generalErrorSelector: "#vc-general-error",
  });
</script>
