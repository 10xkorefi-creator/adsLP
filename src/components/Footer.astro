---
interface Props {
  hideTestimonials?: boolean;
}

const { hideTestimonials = false } = Astro.props;
---

<!-- Section 5: Footer (Exact Match to Image) -->
<footer class="bg-black text-white pt-16 pb-10 border-t border-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between gap-10 pb-16">
      
      <!-- Left Column -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2">
          <img src="/korefi-logo.png" alt="AI Accountant Logo" class="h-8 w-auto" />
          <span class="text-xl font-bold text-white tracking-tight">AI Accountant</span>
        </div>
        <p class="text-xs text-slate-400 font-medium">
          *Offer applicable for annual plans
        </p>
      </div>

      <!-- Right Column: Quick Links -->
      <div class="text-left md:text-right">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">Quick Links</h4>
        <ul class="space-y-2 text-xs font-medium text-slate-400">
          <li><a href="#hero" class="hover:text-white transition-colors">Home</a></li>
          {!hideTestimonials && (
            <li><a href="#tally-reviews" class="hover:text-white transition-colors">Testimonials</a></li>
          )}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
      <p>© 2026 AI Accountant. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/69a92b7bd26f8cfca36689f6_Terms%20of%20Use%20-%20Final.pdf" target="_blank" rel="noopener" class="hover:text-slate-300 transition-colors">Terms</a>
        <a href="https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/6a44d5f5042f7ab8d58990ad_Privacy%20Policy_AIA_6.0_300626%20%201%20(1).pdf" target="_blank" rel="noopener" class="hover:text-slate-300 transition-colors">Privacy</a>
      </div>
    </div>
  </div>
</footer>
