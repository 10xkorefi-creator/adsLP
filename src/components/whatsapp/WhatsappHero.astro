---
// WhatsappHero.astro
---
<style>
  .minimal-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .minimal-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .minimal-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 10px;
  }
  .minimal-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.3);
  }
  .minimal-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
<section class="relative pt-12 pb-12 lg:pt-16 lg:pb-16 xl:pt-20 xl:pb-20 bg-slate-50 overflow-hidden flex items-center min-h-[90vh]" id="hero">
  <!-- WhatsApp brand color glow in background -->
  <div class="absolute top-0 right-1/4 w-[800px] h-[800px] bg-[#25D366]/10 rounded-full blur-[120px] -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      
      <!-- Text Content -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-slate-700 font-semibold text-sm mb-6 border border-slate-200 shadow-sm">
          <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Live on WhatsApp
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black tracking-tight text-slate-900 leading-[1.1] mb-4">
          Chat with your accounting data.<br />
          <span class="text-[#25D366]">Right inside WhatsApp.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-600 mb-6 leading-relaxed font-medium max-w-xl">
          Cash in hand, who owes you money, what you owe, today's sales. Ask AI Accountant like you'd message anyone else and get a straight answer in seconds. Connected to your Tally, live on WhatsApp, free to start.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 mb-4">
          <button onclick="openWaitlistModal()" class="w-full sm:w-auto inline-flex items-center justify-center bg-[#25D366] hover:bg-[#1DA851] text-white font-bold text-xl px-12 py-5 rounded-2xl shadow-xl shadow-[#25D366]/20 transition-all hover:-translate-y-1">
            Join The Waitlist
          </button>
        </div>
        <p class="text-sm font-semibold text-slate-500">
          Free to start. Connect your Tally to AI Accountant once, then just chat.
        </p>
      </div>
      
      <!-- Phone Mockup Visual -->
      <div class="relative mx-auto w-full max-w-[300px] lg:max-w-[320px] perspective-1000">
        <!-- Decoration behind phone -->
        <div class="absolute -inset-4 bg-gradient-to-r from-[#25D366]/20 to-emerald-200/20 rounded-full blur-2xl -z-10"></div>
        
        <!-- Phone Frame -->
        <div class="bg-slate-900 rounded-[3rem] p-3 shadow-2xl ring-1 ring-slate-900/5 transform lg:rotate-y-[-10deg] lg:rotate-x-[5deg] transition-transform duration-500 hover:rotate-0">
          <div class="bg-[#EFEAE2] rounded-[2.25rem] overflow-hidden border border-slate-800 relative h-[520px] lg:h-[540px] flex flex-col">
            
            <!-- Phone Notch / Status Bar Area -->
            <div class="absolute top-0 inset-x-0 h-7 flex justify-center z-20">
              <div class="w-32 h-6 bg-slate-900 rounded-b-3xl"></div>
            </div>
            
            <!-- WhatsApp Header -->
            <div class="bg-[#075E54] text-white pt-10 pb-3 px-4 flex items-center gap-3 shadow-md z-10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
              <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center border-2 border-white/20 overflow-hidden">
                <img src="/korefi-logo.png" alt="AI Accountant Logo" class="w-full h-full object-contain p-1" />
              </div>
              <div>
                <h3 class="font-bold text-base leading-tight">AI Accountant</h3>
                <p class="text-xs text-white/80">online</p>
              </div>
            </div>
            
            <!-- WhatsApp Chat Background Pattern -->
            <div class="absolute inset-0 top-[88px] opacity-60 pointer-events-none bg-cover bg-center" style="background-image: url('/whatsapp-bg.png');"></div>
            
            <!-- Chat Area -->
            <div class="flex-1 p-4 flex flex-col gap-4 overflow-y-auto minimal-scrollbar z-10 relative">
              <div class="flex justify-center mb-2">
                <span class="bg-[#E1F3FB] text-slate-600 text-[11px] px-3 py-1 rounded-lg font-medium shadow-sm">Today</span>
              </div>
              
              <!-- Message: User -->
              <div class="flex justify-end mb-2">
                <div class="bg-[#D9FDD3] text-slate-800 p-3 rounded-l-xl rounded-br-xl rounded-tr-sm shadow-sm max-w-[85%] relative">
                  <p class="text-[15px] leading-snug font-medium">kitna cash hai?</p>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-500">10:42 am</span>
                    <svg class="w-3.5 h-3.5 text-[#53bdeb]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 18L7.5 13.5l1.4-1.4 3.1 3.1 8.6-8.6 1.4 1.4z"/><path d="M4 18l-4.5-4.5 1.4-1.4 3.1 3.1z"/></svg>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -right-2 top-0 w-4 h-4 text-[#D9FDD3]">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M8 0L0 0 0 13C0 13 4 8 8 0Z"/></svg>
                  </div>
                </div>
              </div>
              
              <!-- Message: Bot -->
              <div class="flex justify-start">
                <div class="bg-white text-slate-800 p-3 rounded-r-xl rounded-bl-xl rounded-tl-sm shadow-sm max-w-[90%] relative border border-slate-100">
                  <p class="text-[15px] leading-snug font-medium text-slate-900 mb-2">
                    Cash + bank: <span class="font-bold">Rs 4,82,300</span> as of today.
                  </p>
                  <p class="text-[15px] leading-snug text-slate-700">
                    Want the breakdown?
                  </p>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-400">10:42 am</span>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -left-2 top-0 w-4 h-4 text-white">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M0 0L8 0 8 13C8 13 4 8 0 0Z"/></svg>
                  </div>
                </div>
              </div>

              <!-- Message: User -->
              <div class="flex justify-end mt-2 mb-2">
                <div class="bg-[#D9FDD3] text-slate-800 p-3 rounded-l-xl rounded-br-xl rounded-tr-sm shadow-sm max-w-[85%] relative">
                  <p class="text-[15px] leading-snug font-medium">ha</p>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-500">10:43 am</span>
                    <svg class="w-3.5 h-3.5 text-[#53bdeb]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 18L7.5 13.5l1.4-1.4 3.1 3.1 8.6-8.6 1.4 1.4z"/><path d="M4 18l-4.5-4.5 1.4-1.4 3.1 3.1z"/></svg>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -right-2 top-0 w-4 h-4 text-[#D9FDD3]">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M8 0L0 0 0 13C0 13 4 8 8 0Z"/></svg>
                  </div>
                </div>
              </div>

               <!-- Message: Bot -->
               <div class="flex justify-start">
                <div class="bg-white text-slate-800 p-3 rounded-r-xl rounded-bl-xl rounded-tl-sm shadow-sm max-w-[95%] relative border border-slate-100">
                  <div class="bg-slate-50 p-2 rounded border border-slate-100 mb-2">
                    <div class="flex justify-between text-[14px] mb-1">
                      <span class="text-slate-600">HDFC Curr 4099:</span>
                      <span class="font-bold text-slate-900">₹3,45,100</span>
                    </div>
                    <div class="flex justify-between text-[14px] mb-1">
                      <span class="text-slate-600">ICICI Curr 8122:</span>
                      <span class="font-bold text-slate-900">₹1,12,000</span>
                    </div>
                    <div class="flex justify-between text-[14px] pt-1 border-t border-slate-200 mt-1">
                      <span class="text-slate-600">Petty Cash:</span>
                      <span class="font-bold text-slate-900">₹25,200</span>
                    </div>
                  </div>
                  <div class="flex justify-end items-center gap-1 mt-1">
                    <span class="text-[10px] text-slate-400">10:43 am</span>
                  </div>
                  <!-- Tail -->
                  <div class="absolute -left-2 top-0 w-4 h-4 text-white">
                    <svg viewBox="0 0 8 13" fill="currentColor"><path d="M0 0L8 0 8 13C8 13 4 8 0 0Z"/></svg>
                  </div>
                </div>
              </div>
              
            </div>
            
            <!-- WhatsApp Input Area -->
            <div class="bg-[#F0F2F5] p-2 flex items-center gap-2 z-10">
              <div class="bg-white rounded-full flex-1 flex items-center px-4 py-2.5 shadow-sm">
                <svg class="w-6 h-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-slate-400 text-[15px] ml-3 flex-1">Message</span>
                <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z" opacity="0.3"/><path d="M20 2H4c-1.1 0-1.99.9-1.99 2v12c0 1.1.89 2 1.99 2H18l4 4V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zm-3-5V9c0-1.1-.9-2-2-2H9c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2z"/></svg>
              </div>
              <div class="w-11 h-11 bg-[#00A884] rounded-full flex items-center justify-center text-white shadow-sm shrink-0">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z"/></svg>
              </div>
            </div>
            
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
