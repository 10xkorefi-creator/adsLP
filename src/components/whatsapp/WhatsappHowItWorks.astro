---
// WhatsappHowItWorks.astro
---
<section class="py-24 bg-slate-900 text-white" id="how-it-works">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-6">
        Connect once. Then just ask.
      </h2>
      <p class="text-xl text-slate-400 font-medium">
        Set it up in under 5 minutes. No complex mapping, no training needed.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connecting line for desktop -->
      <div class="hidden md:block absolute top-12 left-1/6 right-1/6 h-0.5 bg-slate-800 z-0"></div>
      
      <!-- Step 1 -->
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="w-24 h-24 bg-slate-800 rounded-full flex items-center justify-center border-4 border-slate-900 shadow-xl mb-8">
          <span class="text-3xl font-black text-[#25D366]">1</span>
        </div>
        <h3 class="text-2xl font-bold mb-4">Add your number.</h3>
        <p class="text-lg text-slate-400 font-medium">
          Save your registered mobile number in Tally Company Details.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="w-24 h-24 bg-slate-800 rounded-full flex items-center justify-center border-4 border-slate-900 shadow-xl mb-8">
          <span class="text-3xl font-black text-[#25D366]">2</span>
        </div>
        <h3 class="text-2xl font-bold mb-4">Sync.</h3>
        <p class="text-lg text-slate-400 font-medium">
          Run Sync Masters in your TDL so your data is securely ready.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="w-24 h-24 bg-[#25D366] rounded-full flex items-center justify-center border-4 border-slate-900 shadow-xl mb-8 shadow-[#25D366]/30">
          <span class="text-3xl font-black text-white">3</span>
        </div>
        <h3 class="text-2xl font-bold mb-4">Say Hi.</h3>
        <p class="text-lg text-slate-400 font-medium">
          Message "Hi" to the AI Accountant WhatsApp number and start asking.
        </p>
      </div>
    </div>
    
  </div>
</section>
