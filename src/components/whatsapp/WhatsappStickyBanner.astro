---
// WhatsappStickyBanner.astro
---
<div class="sticky top-0 z-[60] w-full bg-[#25D366] shadow-md border-b border-[#1DA851]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-row items-center justify-between py-2 sm:py-3 gap-2">
      <!-- Left side message -->
      <div class="flex-1">
        <p class="text-white text-sm sm:text-base md:text-lg font-black tracking-tight leading-tight drop-shadow-sm">
          <span class="animate-pulse inline-block">✨</span> 
          Free forever for the first 100 users! 
          <span class="block sm:inline sm:ml-1 text-xs sm:text-sm md:text-base font-bold opacity-90 mt-0.5 sm:mt-0">
            Lock in your spot today.
          </span>
        </p>
      </div>

      <!-- CTA Button -->
      <button 
        onclick="window.openWaitlistModal()" 
        class="shrink-0 bg-[#075E54] hover:bg-[#128C7E] text-white text-xs sm:text-sm font-bold py-2 px-4 sm:px-6 rounded-full transition-transform hover:scale-105 shadow-md whitespace-nowrap"
      >
        Join Waitlist
      </button>
    </div>
  </div>
</div>
