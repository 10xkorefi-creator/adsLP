---
---

<!-- Section 1: Hero Header & Lead Form (Glassmorphism & Gradients) -->
<header
  class="relative pt-6 pb-12 lg:pt-20 lg:pb-28 overflow-hidden bg-slate-50"
  id="hero"
>
  <!-- Animated Background Elements (Orbs that highlight title and form) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <!-- Glowing Orb 1: Highlights the Title (Left) -->
    <div
      class="absolute top-[-10%] left-[-10%] w-[50%] h-[60%] bg-purple-400/40 rounded-full blur-[100px] lg:blur-[140px] animate-blob"
    ></div>
    <!-- Glowing Orb 2: Highlights the Form (Right) -->
    <div
      class="absolute top-[10%] right-[-5%] w-[45%] h-[65%] bg-blue-400/40 rounded-full blur-[100px] lg:blur-[140px] animate-blob animation-delay-2000"
    ></div>
    <!-- Glowing Orb 3: Center Fill -->
    <div
      class="absolute bottom-[-20%] left-[20%] w-[40%] h-[50%] bg-pink-300/30 rounded-full blur-[100px] lg:blur-[140px] animate-blob animation-delay-4000"
    ></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Left Hero Content Column -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <!-- Floating Offer Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/60 border border-white/80 shadow-sm backdrop-blur-md w-fit mb-6 lg:mb-8 hover:bg-white/80 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
          </span>
          <span class="text-xs sm:text-sm font-bold text-slate-800 tracking-wide uppercase">
            3 days left <span class="text-slate-400 mx-1">|</span> <span class="text-red-600">40% off</span>
          </span>
        </div>

        <!-- MASSIVE H1 HEADLINE (Gradient Highlight) -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.1] lg:leading-[1.05] tracking-tight mb-5 lg:mb-7 text-slate-900"
        >
          <span class="block text-slate-900">AI-Powered</span>
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-pink-500 to-purple-600 animate-gradient-x py-1">
            Financial Engine
          </span>
        </h1>

        <!-- Description Paragraph -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-600 font-medium leading-relaxed mb-8 max-w-lg lg:max-w-xl">
          Automate bookkeeping, eliminate manual errors, and gain real-time financial insights directly within Tally.
        </p>

        <!-- Trust Certifications -->
        <div class="flex items-center gap-4 sm:gap-6 pt-4 border-t border-slate-200/60 max-w-lg">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <span class="text-xs sm:text-sm font-bold text-slate-700 leading-tight">ISO 27001<br/><span class="font-medium text-slate-500">Certified</span></span>
          </div>
          <div class="w-px h-8 bg-slate-200"></div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded bg-purple-100 flex items-center justify-center text-purple-600 shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <span class="text-xs sm:text-sm font-bold text-slate-700 leading-tight">SOC 2 Type II<br/><span class="font-medium text-slate-500">Compliant</span></span>
          </div>
        </div>
      </div>

      <!-- Right Form Card Column (Glassmorphism Highlighted) -->
      <div class="lg:col-span-6 relative mt-10 lg:mt-0" id="lead-form-container">
        
        <!-- Animated border / aura behind the form -->
        <div class="absolute -inset-1 bg-gradient-to-r from-purple-500 via-blue-500 to-pink-500 rounded-2xl blur opacity-30 animate-tilt"></div>

        <!-- The Glass Form Card -->
        <div class="relative bg-white/70 backdrop-blur-xl border border-white/60 shadow-2xl rounded-2xl p-5 sm:p-7 lg:p-8">
          
          <!-- Subtle top reflection highlight -->
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white to-transparent opacity-80"></div>

          <div class="flex items-center justify-between gap-2 mb-6 pb-4 border-b border-slate-200/50">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Book A Demo
            </h2>
            <span class="inline-flex items-center gap-1.5 bg-purple-100/80 backdrop-blur-sm text-purple-800 text-xs font-extrabold px-2.5 py-1 rounded-full border border-purple-200/50">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-600 animate-pulse"></span>
              40 slots available
            </span>
          </div>

          <form id="astroLeadForm" class="space-y-3 lg:space-y-4" novalidate>
            <!-- Field 1: First Name -->
            <div>
              <input
                type="text"
                id="astro-first_name"
                name="first_name"
                class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm"
                placeholder="Name *"
                required
              />
              <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-first_name-error">Please enter your name</span>
            </div>

            <!-- Field 2: Email -->
            <div>
              <input
                type="email"
                id="astro-email"
                name="email"
                class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm"
                placeholder="Work Email *"
                required
              />
              <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-email-error">Please enter a valid work email</span>
            </div>

            <!-- Field 3 & 4 Row: Phone & Software -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-4">
              <div>
                <input
                  type="tel"
                  id="astro-lg__phone"
                  name="lg__phone"
                  class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm"
                  placeholder="Phone Number *"
                  required
                />
                <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-lg__phone-error">Please enter exactly 10 digits</span>
              </div>
              <div class="relative">
                <select
                  id="astro-which_accounting_tool_do_you_use"
                  name="which_accounting_tool_do_you_use"
                  class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm appearance-none cursor-pointer"
                  required
                >
                  <option value="" disabled selected>Accounting Tool *</option>
                  <option value="Tally">Tally</option>
                  <option value="Zoho Books">Zoho Books</option>
                  <option value="Others">Others</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
                <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-which_accounting_tool_do_you_use-error">Please select an accounting tool</span>
              </div>
            </div>

            <!-- Field 5 & 6 Row: Team Size & Role -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-4">
              <div class="relative">
                <select
                  id="astro-accounting_team_size"
                  name="accounting_team_size"
                  class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm appearance-none cursor-pointer"
                  required
                >
                  <option value="" disabled selected>Team Size *</option>
                  <option value="1-3">1-3</option>
                  <option value="3-5">3-5</option>
                  <option value="5-10">5-10</option>
                  <option value="10+">10+</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
                <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-accounting_team_size-error">Please select team size</span>
              </div>
              <div class="relative">
                <select
                  id="astro-which_best_describes_you"
                  name="which_best_describes_you"
                  class="w-full h-12 lg:h-14 px-4 bg-white/80 border border-slate-200/80 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-500 focus:bg-white focus:ring-4 focus:ring-purple-500/10 transition-all shadow-sm appearance-none cursor-pointer"
                  required
                >
                  <option value="" disabled selected>Your Role *</option>
                  <option value="CA firm: automating my clients' books">CA firm</option>
                  <option value="Business owner: automating my company's accounting">Business owner</option>
                  <option value="Finance team: looking to automate our books">Finance team</option>
                  <option value="Channel partner: looking to resell AiA">Channel partner</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
                <span class="text-xs font-semibold text-[#dc2626] hidden mt-1" id="astro-which_best_describes_you-error">Please select your role</span>
              </div>
            </div>

            <!-- Submit Button (Gradient Highlight) -->
            <button
              type="submit"
              id="Tally-Automation"
              class="group relative w-full h-14 mt-4 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-extrabold text-lg rounded-xl shadow-[0_8px_16px_rgba(124,58,237,0.2)] hover:shadow-[0_12px_24px_rgba(124,58,237,0.3)] transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer flex items-center justify-center overflow-hidden"
            >
              <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
              <span class="relative z-10 flex items-center gap-2">
                Submit
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </button>
            
            <span id="astro-general-error" class="text-xs font-semibold text-[#dc2626] hidden mt-2 text-center block">
              Couldn't save your details. Please try again.
            </span>

            <p class="text-xs text-slate-500/80 text-center pt-3 font-medium leading-relaxed">
              By submitting, you agree to our <a href="https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/6a44d5f5042f7ab8d58990ad_Privacy%20Policy_AIA_6.0_300626%20%201%20(1).pdf" target="_blank" rel="noopener" class="text-purple-600 font-bold hover:underline transition-all">Privacy Policy</a>.
            </p>
          </form>

          <div id="astroSuccessMessage" class="hidden text-center py-10">
            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full inline-flex items-center justify-center mb-4 shadow-sm">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-2">
              You're All Set!
            </h3>
            <p class="text-slate-600 font-medium">
              Thank you for requesting a demo. Our team will contact you shortly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Custom Animations for Glassmorphism */
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  
  @keyframes tilt {
    0%, 50%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(1deg); }
    75% { transform: rotate(-1deg); }
  }

  @keyframes gradient-x {
    0%, 100% {
      background-size: 200% 200%;
      background-position: left center;
    }
    50% {
      background-size: 200% 200%;
      background-position: right center;
    }
  }
  
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
  
  .animate-blob {
    animation: blob 10s infinite;
  }
  
  .animate-tilt {
    animation: tilt 10s infinite linear;
  }
  
  .animate-gradient-x {
    animation: gradient-x 6s ease infinite;
  }
  
  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>

<script>
  // Editable configuration
  const CONFIG = {
    contactSource: "Tally Automation",
    defaultRouterId: "4963",
    channelPartnerRouterId: "6273",
    triggerSelector: "#Tally-Automation",
    webhookUrl: "https://aiacc.app.n8n.cloud/webhook/ce246056-bdd0-4199-b363-3b44ed255f96",
    blockedTools: ["Zoho Books", "Others"],
    webhookOnAllPaths: false,
    debug: true,
  };

  const CLICK_ID_MAP: Record<string, string> = {
    gclid: "hs_google_click_id",
    fbclid: "hs_facebook_click_id",
    li_fat_id: "hs_linkedin_click_id",
  };

  const UTM_PARAMS = [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "placements",
    "utm_device",
  ];

  function ensureRevenueHeroLoaded(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).RevenueHero) {
        return resolve();
      }
      const existingScript = document.querySelector(
        'script[src*="revenuehero.io"]',
      );
      if (existingScript) {
        existingScript.addEventListener("load", () => resolve());
        setTimeout(() => resolve(), 1200);
        return;
      }
      const script = document.createElement("script");
      script.src = "https://assets.revenuehero.io/scheduler.min.js";
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => resolve();
      document.head.appendChild(script);
    });
  }

  function captureAttribution(form: HTMLFormElement) {
    const urlParams = new URLSearchParams(window.location.search);
    const attributionData: Record<string, string> = {};

    Object.entries(CLICK_ID_MAP).forEach(([paramName, storageKey]) => {
      const urlValue = urlParams.get(paramName);
      if (urlValue) {
        sessionStorage.setItem(storageKey, urlValue);
        attributionData[storageKey] = urlValue;
      } else {
        const storedValue = sessionStorage.getItem(storageKey);
        if (storedValue) {
          attributionData[storageKey] = storedValue;
        }
      }
    });

    UTM_PARAMS.forEach((paramName) => {
      const value = urlParams.get(paramName);
      if (value) {
        attributionData[paramName] = value;
      }
    });

    attributionData["contact_source"] = CONFIG.contactSource;

    Object.entries(attributionData).forEach(([key, val]) => {
      if (val) {
        let input = form.querySelector(
          `input[name="${key}"]`,
        ) as HTMLInputElement;
        if (!input) {
          input = document.createElement("input");
          input.type = "hidden";
          input.name = key;
          form.appendChild(input);
        }
        input.value = val;
      }
    });

    return attributionData;
  }

  function initLeadForm() {
    const form = document.getElementById("astroLeadForm") as HTMLFormElement;
    if (!form) return;

    captureAttribution(form);

    const nameInput = document.getElementById("astro-first_name") as HTMLInputElement;
    const emailInput = document.getElementById("astro-email") as HTMLInputElement;
    const phoneInput = document.getElementById("astro-lg__phone") as HTMLInputElement;
    const softwareSelect = document.getElementById("astro-which_accounting_tool_do_you_use") as HTMLSelectElement;
    const teamSizeSelect = document.getElementById("astro-accounting_team_size") as HTMLSelectElement;
    const roleSelect = document.getElementById("astro-which_best_describes_you") as HTMLSelectElement;
    const generalErr = document.getElementById("astro-general-error");
    const successMsg = document.getElementById("astroSuccessMessage");

    let isRhExecuting = false;

    if (phoneInput) {
      phoneInput.addEventListener("input", () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
      });
    }

    const setFieldError = (
      fieldElement: HTMLElement | null,
      errorSpan: HTMLElement | null,
      isError: boolean,
    ) => {
      if (fieldElement) {
        if (isError) {
          fieldElement.style.border = "2px solid #dc2626";
          fieldElement.style.backgroundColor = "#fef2f2";
        } else {
          fieldElement.style.border = "";
          fieldElement.style.backgroundColor = "";
        }
      }
      if (errorSpan) {
        if (isError) {
          errorSpan.classList.remove("hidden");
        } else {
          errorSpan.classList.add("hidden");
        }
      }
    };

    [
      { input: nameInput, errId: "astro-first_name-error" },
      { input: emailInput, errId: "astro-email-error" },
      { input: phoneInput, errId: "astro-lg__phone-error" },
      { input: softwareSelect, errId: "astro-which_accounting_tool_do_you_use-error" },
      { input: teamSizeSelect, errId: "astro-accounting_team_size-error" },
      { input: roleSelect, errId: "astro-which_best_describes_you-error" },
    ].forEach(({ input, errId }) => {
      if (!input) return;
      const errSpan = document.getElementById(errId);
      const clear = () => {
        setFieldError(input, errSpan, false);
        if (generalErr) generalErr.classList.add("hidden");
      };
      input.addEventListener("input", clear);
      input.addEventListener("focus", clear);
      input.addEventListener("change", clear);
    });

    const validateForm = () => {
      let isValid = true;
      let firstErroredField: HTMLElement | null = null;

      const nameVal = nameInput?.value.trim() || "";
      const nameErrSpan = document.getElementById("astro-first_name-error");
      if (!nameVal) {
        setFieldError(nameInput, nameErrSpan, true);
        isValid = false;
        if (!firstErroredField && nameInput) firstErroredField = nameInput;
      } else {
        setFieldError(nameInput, nameErrSpan, false);
      }

      const emailVal = emailInput?.value.trim() || "";
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const emailErrSpan = document.getElementById("astro-email-error");
      if (!emailVal || !emailRegex.test(emailVal)) {
        setFieldError(emailInput, emailErrSpan, true);
        isValid = false;
        if (!firstErroredField && emailInput) firstErroredField = emailInput;
      } else {
        setFieldError(emailInput, emailErrSpan, false);
      }

      const phoneDigits = (phoneInput?.value || "").replace(/\D/g, "");
      const phoneErrSpan = document.getElementById("astro-lg__phone-error");
      if (phoneDigits.length !== 10) {
        setFieldError(phoneInput, phoneErrSpan, true);
        isValid = false;
        if (!firstErroredField && phoneInput) firstErroredField = phoneInput;
      } else {
        setFieldError(phoneInput, phoneErrSpan, false);
      }

      [
        { select: softwareSelect, errId: "astro-which_accounting_tool_do_you_use-error" },
        { select: teamSizeSelect, errId: "astro-accounting_team_size-error" },
        { select: roleSelect, errId: "astro-which_best_describes_you-error" },
      ].forEach(({ select, errId }) => {
        const errSpan = document.getElementById(errId);
        if (select && !select.value) {
          setFieldError(select, errSpan, true);
          isValid = false;
          if (!firstErroredField) firstErroredField = select;
        } else if (select) {
          setFieldError(select, errSpan, false);
        }
      });

      if (!isValid && firstErroredField) {
        firstErroredField.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
        firstErroredField.focus();
      }

      return isValid;
    };

    form.addEventListener("submit", async (e) => {
      if (isRhExecuting) {
        return;
      }

      e.preventDefault();

      if (generalErr) generalErr.classList.add("hidden");

      captureAttribution(form);

      const isValid = validateForm();
      if (!isValid) {
        if (CONFIG.debug) {
          console.log("[DemoForm] Validation failed. Submission blocked.");
        }
        return;
      }

      const formData = new FormData(form);
      const payload: Record<string, string> = {};
      formData.forEach((value, key) => {
        const strVal = value.toString().trim();
        if (strVal) {
          payload[key] = strVal;
        }
      });

      const toolVal = payload["which_accounting_tool_do_you_use"] || "";
      const roleVal = payload["which_best_describes_you"] || "";
      const isChannelPartner = roleVal
        .trim()
        .toLowerCase()
        .startsWith("channel partner");

      const isBlockedTool = CONFIG.blockedTools.some(
        (blocked) => blocked.toLowerCase() === toolVal.toLowerCase(),
      );

      if (isBlockedTool) {
        if (CONFIG.debug) {
          console.log("[DemoForm] Routing: BLOCKED TOOL (Webhook path)", {
            toolVal,
            isChannelPartner,
            chosenRouterId: null,
          });
          console.table(payload);
        }

        const submitBtn = document.querySelector(
          CONFIG.triggerSelector,
        ) as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.style.pointerEvents = "none";
          submitBtn.style.opacity = "0.6";
          submitBtn.innerText = "Submitting...";
        }

        try {
          const res = await fetch(CONFIG.webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              ...payload,
              __page: window.location.href,
              __event: "form_submit_blocked_tool",
            }),
          });

          if (!res.ok) {
            throw new Error(`Webhook status: ${res.status}`);
          }

          form.style.display = "none";
          if (successMsg) successMsg.classList.remove("hidden");
        } catch (err) {
          console.error("[DemoForm] Webhook error:", err);
          if (generalErr) generalErr.classList.remove("hidden");
          if (submitBtn) {
            submitBtn.style.pointerEvents = "auto";
            submitBtn.style.opacity = "1.0";
            submitBtn.innerText = "Submit";
          }
        }
        return;
      }

      const chosenRouterId = isChannelPartner
        ? CONFIG.channelPartnerRouterId
        : CONFIG.defaultRouterId;

      if (CONFIG.debug) {
        console.log("[DemoForm] Routing: REVENUEHERO SCHEDULER", {
          toolVal,
          isChannelPartner,
          chosenRouterId,
        });
        console.table(payload);
      }

      if (CONFIG.webhookOnAllPaths) {
        fetch(CONFIG.webhookUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            ...payload,
            __page: window.location.href,
            __event: "form_submit_scheduled",
          }),
        }).catch(() => {});
      }

      await ensureRevenueHeroLoaded();

      const oldTrigger = document.querySelector(
        CONFIG.triggerSelector,
      ) as HTMLElement;

      if (oldTrigger) {
        const clonedTrigger = oldTrigger.cloneNode(true) as HTMLElement;
        oldTrigger.parentNode?.replaceChild(clonedTrigger, oldTrigger);
      }

      if ((window as any).RevenueHero) {
        (window as any).hero = new (window as any).RevenueHero({
          routerId: chosenRouterId,
        });

        (window as any).hero.schedule("#astroLeadForm");
        (window as any).hero.schedule(CONFIG.triggerSelector);

        isRhExecuting = true;

        form.dispatchEvent(
          new Event("submit", { cancelable: true, bubbles: true }),
        );

        setTimeout(() => {
          isRhExecuting = false;
        }, 150);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLeadForm);
  } else {
    initLeadForm();
  }
  document.addEventListener("astro:page-load", initLeadForm);
</script>
