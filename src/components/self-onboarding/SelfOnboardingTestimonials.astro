---
// Testimonials for the self-onboarding LP. Mobile: one swipeable row (snap). Desktop: 3-column masonry.
// Vadivel and Sunil (Tally quotes) last, so they close the mobile slider. Data mirrors components/Testimonials.astro (left untouched).
const items = [
  { quote: "AI Accountant has really simplified things for us. The way it automatically matches transactions to invoices has saved us so much time.", author: "Dhruvin Patel", role: "CEO at Virtual Tech", logo: "/virtual-tech-logo.png" },
  { quote: "AI Accountant has made financial management effortless. Expense categorization and bills automation simplify coordination with my CA, and this new dashboard helps track business performance. I suggested adding bank charge tracking, and AI Accountant built it; truly customer-focused!", author: "Nishu B.", role: "Co-Founder, UrbanWatch", logo: "/urbanwatch.png" },
  { quote: "Tracking invoices and payments manually was a challenge for us. AI Accountant's AP/AR Dashboard gives complete visibility into our bills and invoices, making reconciliation effortless.", author: "Pragya Chandra", role: "Director of Business Development, Trip India", logo: "/trip-india.png" },
  { quote: "AI Accountant makes it so much easier to move away from spreadsheets and have receivables and payables tracking in one place.", author: "Bhupendra Singh", role: "Managing Partner, Trifactorial Consulting LLP", logo: "/trifactorial.png" },
  { quote: "Through AI Accountant with just one click, I can create customized reports and track my finances in real-time, no more waiting until the year-end to see where things stand.", author: "Chandan Prasad", role: "Head Operation at SUBHAG® HealthTech", logo: "/subhag.png" },
  { quote: "Clients can upload documents, track filing status, and access reports 24/7. It's elevated our firm's professional image.", author: "Adarsh MG", role: "Managing Partner at Acc 'N' More", logo: "/acc-n-more.png" },
  { quote: "The Tally integration with AI Accountant has been transformative. What earlier took hours of manual entry now syncs seamlessly in minutes, and the best part is how it connects directly with our dashboards. We can now show clients clean, real-time numbers during every review meeting.", author: "Vadivel CMA", role: "Founder at Vadivel & Co" },
  { quote: "AI Accountant has eliminated the repetitive task of converting bank statements into Tally entries. This has increased efficiency across our team and allows us to focus on reconciliations and analysis rather than manual pasting. The way it blends into our traditional accounting processes is seamless.", author: "Sunil", role: "Calculators - The Tax People" },
];
const initials = (n: string) => n.replace(/[^A-Za-z ]/g, "").trim().charAt(0);
---

<section class="py-12 lg:py-20 bg-neutral-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl font-bold text-center">Real results, real success</h2>
    <p class="mt-2 text-center text-neutral-600">Hear from our clients</p>
  </div>

  <div class="mt-8 lg:mt-12 max-w-6xl mx-auto lg:px-6">
    <ul id="so-tm-track" class="so-tm-track flex gap-3 overflow-x-auto snap-x snap-mandatory px-4 pb-2 lg:block lg:columns-3 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0">
      {items.map((t) => (
        <li class="snap-center shrink-0 w-[85%] sm:w-[60%] lg:w-auto lg:mb-5 lg:break-inside-avoid">
          <figure class="h-full flex flex-col rounded-xl border border-neutral-200 bg-white p-5 lg:p-6">
            <svg class="w-6 h-6 text-[#314DD0]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7.3 4.5 10 4.5 13.3V18h5.6v-5.6H7.4c.1-2 1.3-3.6 3.1-4.5L9.5 6Zm9 0c-3 1.3-5 4-5 7.3V18h5.6v-5.6h-2.7c.1-2 1.3-3.6 3.1-4.5L18.5 6Z"/></svg>
            <blockquote class="mt-3 text-[15px] leading-relaxed text-neutral-800 flex-1">{t.quote}</blockquote>
            <figcaption class="mt-5 pt-4 border-t border-neutral-100 flex items-center gap-3">
              {t.logo
                ? <img src={t.logo} alt="" loading="lazy" class="w-10 h-10 object-contain shrink-0" />
                : <span class="w-10 h-10 rounded-full bg-black text-white font-bold flex items-center justify-center shrink-0">{initials(t.author)}</span>}
              <span class="min-w-0">
                <span class="block font-bold text-sm">{t.author}</span>
                <span class="block text-xs text-neutral-500">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <div id="so-tm-dots" class="lg:hidden mt-4 flex justify-center gap-1.5" aria-hidden="true">
      {items.map((_, i) => <span class:list={["h-1.5 rounded-full transition-all", i === 0 ? "w-5 bg-[#314DD0]" : "w-1.5 bg-neutral-300"]}></span>)}
    </div>
  </div>
</section>

<style>
  .so-tm-track { scrollbar-width: none; scroll-padding-inline: 1rem; }
  .so-tm-track::-webkit-scrollbar { display: none; }
</style>

<script>
  // Dots follow the swipe position (mobile only).
  const track = document.getElementById("so-tm-track");
  const dots = Array.from(document.querySelectorAll<HTMLElement>("#so-tm-dots span"));
  if (track && dots.length) {
    let raf = 0;
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const cards = Array.from(track.children) as HTMLElement[];
        const mid = track.scrollLeft + track.clientWidth / 2;
        let idx = 0, best = Infinity;
        cards.forEach((c, i) => { const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid); if (d < best) { best = d; idx = i; } });
        dots.forEach((d, i) => {
          d.classList.toggle("w-5", i === idx); d.classList.toggle("bg-[#314DD0]", i === idx);
          d.classList.toggle("w-1.5", i !== idx); d.classList.toggle("bg-neutral-300", i !== idx);
        });
      });
    }, { passive: true });
  }
</script>
