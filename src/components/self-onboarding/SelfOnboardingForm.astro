---
// Self-onboarding form. Mirrors the Webflow form on /meta/tally-automation (fields, dropdown labels and values,
// "Tally setup" shown only for Tally / Both), with one change from the brief: First Name and Last Name are separate.
// On submit: routeLead (owner + token) -> sendToRouterWebhook (HubSpot, fire and forget) -> sign-up page, pre-filled.
interface Props {
  contactSource?: string;
  pageKey?: string;
}
const { contactSource = "Tally Self Onboarding", pageKey = "tally-self-onboarding" } = Astro.props;

const input =
  "w-full h-12 px-4 rounded-md border border-neutral-300 bg-white text-black text-base placeholder-neutral-500 outline-none transition focus:border-[#314DD0] focus:ring-2 focus:ring-[#314DD0]/20";
const select = `${input} cursor-pointer`;
const err = "hidden text-red-600 text-xs mt-1 font-medium";

// Same labels and values as the Meta page (values are what HubSpot and the router already receive).
const tools = ["Tally", "Zoho Books", "Both", "SAP", "Oracle NetSuite", "Microsoft Dynamics 365", "Odoo", "Others"];
const tallySetups = [
  { value: "Cloud-hosted", label: "Cloud-hosted" },
  { value: "Offline", label: "Offline (local system)" },
  { value: "not-sure", label: "Not sure" },
];
const teamSizes = ["0", "1-3", "3-5", "5-10", "10+"];
const roles = [
  { value: "CA firm", label: "CA firm: automating my clients' books" },
  { value: "Business owner", label: "Business owner: automating my company's accounting" },
  { value: "finance team", label: "Finance team: looking to automate our books" },
  { value: "Channel partner", label: "Channel partner: looking to resell AiA" },
];
---

<form id="so-form" class="grid grid-cols-1 sm:grid-cols-2 gap-3" novalidate data-contact-source={contactSource} data-page-key={pageKey}>
  <div>
    <label for="so-first_name" class="sr-only">First Name</label>
    <input type="text" id="so-first_name" name="first_name" maxlength="256" autocomplete="given-name" class={input} placeholder="First Name *" required />
    <span id="so-first_name-error" class={err}>Please enter your first name.</span>
  </div>
  <div>
    <label for="so-last_name" class="sr-only">Last Name</label>
    <input type="text" id="so-last_name" name="last_name" maxlength="256" autocomplete="family-name" class={input} placeholder="Last Name *" required />
    <span id="so-last_name-error" class={err}>Please enter your last name.</span>
  </div>

  <div class="sm:col-span-2">
    <label for="so-email" class="sr-only">Email Address</label>
    <input type="email" id="so-email" name="email" maxlength="256" autocomplete="email" class={input} placeholder="Email Address *" required />
    <span id="so-email-error" class={err}>Please enter a valid email address.</span>
  </div>

  <div>
    <label for="so-phone" class="sr-only">Phone number</label>
    <div class="flex">
      <span class="inline-flex items-center px-4 h-12 bg-neutral-100 border border-r-0 border-neutral-300 rounded-l-md text-neutral-700 font-medium select-none shrink-0">+91</span>
      <input type="tel" id="so-phone" name="lg__phone" inputmode="numeric" autocomplete="tel-national" class={`${input} rounded-l-none`} placeholder="Phone number *" required />
    </div>
    <span id="so-phone-error" class={err}>Enter a valid 10-digit number.</span>
  </div>
  <div>
    <label for="so-company" class="sr-only">Company Name</label>
    <input type="text" id="so-company" name="company" maxlength="256" autocomplete="organization" class={input} placeholder="Company Name *" required />
    <span id="so-company-error" class={err}>Please enter your company name.</span>
  </div>

  <div class="sm:col-span-2">
    <label for="so-accounting_tool" class="sr-only">Which accounting tool do you currently use?</label>
    <select id="so-accounting_tool" name="which_accounting_tool_do_you_use" class={select} required>
      <option value="" disabled selected>Which accounting tool do you currently use? *</option>
      {tools.map((t) => <option value={t}>{t}</option>)}
    </select>
    <span id="so-accounting_tool-error" class={err}>Please select your accounting tool.</span>
  </div>

  <!-- Shown only when the tool is Tally or Both (same rule as the Meta page) -->
  <div id="so-tally_setup-container" class="sm:col-span-2" style="display:none">
    <label for="so-tally_setup" class="sr-only">Is your Tally on cloud or local?</label>
    <select id="so-tally_setup" name="tally_setup" class={select} disabled>
      <option value="" selected>Is your Tally on cloud or local? *</option>
      {tallySetups.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
    <span id="so-tally_setup-error" class={err}>Please select an option.</span>
  </div>

  <div class="sm:col-span-2">
    <label for="so-team_size" class="sr-only">Your current accounting team size</label>
    <select id="so-team_size" name="accounting_team_size" class={select} required>
      <option value="" disabled selected>Your current accounting team size *</option>
      {teamSizes.map((t) => <option value={t}>{t}</option>)}
    </select>
    <span id="so-team_size-error" class={err}>Please select team size.</span>
  </div>
  <div class="sm:col-span-2">
    <label for="so-role" class="sr-only">Which best describes you?</label>
    <select id="so-role" name="which_best_describes_you" class={select} required>
      <option value="" disabled selected>Which best describes you? *</option>
      {roles.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
    <span id="so-role-error" class={err}>Please select your role.</span>
  </div>

  <!-- Bot trap, same field name as the Webflow forms: hidden from people, bots fill it -->
  <input type="text" name="lr_hpf_x7" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] w-px h-px opacity-0 pointer-events-none" />

  <div class="sm:col-span-2 mt-1">
    <button type="submit" id="so-submit" class="w-full h-13 py-3.5 rounded-md bg-[#314DD0] hover:bg-[#2a42b5] text-white font-bold text-lg transition disabled:opacity-70 disabled:cursor-wait">
      Start Free Trial
    </button>
    <p class="text-sm text-neutral-600 text-center mt-2.5">No card needed. Works with your Tally.</p>
    <p class="text-xs text-neutral-500 text-center mt-2">
      By submitting this form, you agree to our <a href="https://www.aiaccountant.com/privacy" target="_blank" rel="noopener" class="underline text-neutral-700 hover:text-black">Privacy Policy</a> and consent to being contacted about our services.
    </p>
  </div>
</form>

<!-- In-place thank-you for Zoho Books / Others (no redirect) -->
<div id="so-success" hidden role="status" aria-live="polite" tabindex="-1" class="outline-none text-center px-2 py-10 sm:py-14 scroll-mt-24">
  <div class="mx-auto w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#314DD0]/10 text-[#314DD0] flex items-center justify-center">
    <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
  </div>
  <h3 class="mt-5 text-2xl sm:text-3xl font-bold leading-tight text-balance">Thanks for submitting the Form</h3>
  <p class="mt-2 text-base sm:text-lg text-neutral-600">We will reach out to you</p>
</div>

<script>
  import { routeLead, sendToRouterWebhook } from "../../scripts/leadRouter";
  import { buildSignupUrl, getClickIds, getUtms, persistAttribution, tenDigitPhone } from "../../scripts/signupRedirect";

  declare global { interface Window { LEAD_REFERENCE?: string } }

  // Only new logic vs the other LPs: UTMs are stored on page load (click IDs already were).
  persistAttribution();

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const TALLY_TRIGGERS = ["tally", "both"]; // same as the Meta page's conditional field
  // Only these tools go to the router + sign-up page. Every other choice (Zoho Books, ERPs, Others, and any
  // option added later) gets the in-form thank-you instead.
  const SIGNUP_TOOLS = ["tally", "both"];
  const SIGNUP_UTM_SOURCE = "meta"; // required by the sign-up page for prefilling
  const LEGACY_WEBHOOK = "https://n8n.aiaccountant.com/webhook/ce246056-bdd0-4199-b363-3b44ed255f96";
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // Digits only. A pasted "+91 98765 43210" / "098765 43210" keeps the real 10 digits instead of the prefix.
  const cleanPhone = (el: HTMLInputElement) => {
    let d = el.value.replace(/\D/g, "");
    if (d.length > 10) d = d.replace(/^(91|0)/, "");
    el.value = d.slice(0, 10);
  };

  const init = () => {
    const form = document.getElementById("so-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const firstName = $<HTMLInputElement>("so-first_name");
    const lastName = $<HTMLInputElement>("so-last_name");
    const email = $<HTMLInputElement>("so-email");
    const company = $<HTMLInputElement>("so-company");
    const phone = $<HTMLInputElement>("so-phone");
    const tool = $<HTMLSelectElement>("so-accounting_tool");
    const setupBox = $<HTMLElement>("so-tally_setup-container");
    const setup = $<HTMLSelectElement>("so-tally_setup");
    const team = $<HTMLSelectElement>("so-team_size");
    const role = $<HTMLSelectElement>("so-role");
    const honeypot = form.querySelector<HTMLInputElement>('input[name="lr_hpf_x7"]');
    const btn = $<HTMLButtonElement>("so-submit");

    const showError = (el: HTMLElement, show: boolean) => {
      el.style.borderColor = show ? "#dc2626" : "";
      document.getElementById(`${el.id}-error`)?.classList.toggle("hidden", !show);
    };

    const syncTallySetup = () => {
      const v = tool.value.trim().toLowerCase();
      const on = TALLY_TRIGGERS.some((t) => v.includes(t));
      setupBox.style.display = on ? "block" : "none";
      setup.disabled = !on;
      setup.required = on;
      if (!on) { setup.value = ""; showError(setup, false); }
    };
    tool.addEventListener("change", syncTallySetup);
    syncTallySetup();

    phone.addEventListener("input", () => cleanPhone(phone));

    [firstName, lastName, email, company, phone, tool, setup, team, role].forEach((el) => {
      el.addEventListener("input", () => showError(el, false));
      el.addEventListener("change", () => showError(el, false));
    });

    const validate = () => {
      const checks: [HTMLElement, boolean][] = [
        [firstName, !!firstName.value.trim()],
        [lastName, !!lastName.value.trim()],
        [email, EMAIL_RE.test(email.value.trim())],
        [phone, tenDigitPhone(phone.value).length === 10],
        [company, !!company.value.trim()],
        [tool, !!tool.value],
        [setup, !setup.required || !!setup.value],
        [team, !!team.value],
        [role, !!role.value],
      ];
      checks.forEach(([el, ok]) => showError(el, !ok));
      const firstBad = checks.find(([, ok]) => !ok)?.[0];
      if (firstBad) {
        firstBad.scrollIntoView({ behavior: "smooth", block: "center" });
        firstBad.focus({ preventScroll: true });
      }
      return !firstBad;
    };

    // In-place thank-you (Zoho Books / Others): hide the form and its card heading, show the message,
    // and bring it into view (on phones the submit button sits well below the top of the card).
    const success = $<HTMLElement>("so-success");
    const showSuccess = () => {
      form.style.display = "none"; // inline style: the form's `grid` class would beat the hidden attribute
      const heading = form.parentElement?.querySelector<HTMLElement>(":scope > h2");
      if (heading) heading.style.display = "none";
      success.hidden = false;
      success.scrollIntoView({ behavior: "smooth", block: "center" });
      success.focus({ preventScroll: true });
      window.dispatchEvent(new CustomEvent("so:lead-done"));
    };

    let submitting = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitting || !validate()) return;
      submitting = true;
      btn.disabled = true;
      btn.textContent = "Setting up your account...";

      const first = firstName.value.trim();
      const last = lastName.value.trim();
      const fullName = `${first} ${last}`.trim();
      const phone10 = tenDigitPhone(phone.value);
      const utm = getUtms();
      const clickIds = getClickIds();

      // Lead payload in HubSpot field names (what the router + n8n already read), same values as the Meta form.
      const payload: Record<string, string> = {
        first_name: first,
        last_name: last,
        email: email.value.trim(),
        company: company.value.trim(),
        lg__phone: phone10,
        which_accounting_tool_do_you_use: tool.value,
        tally_setup: setup.disabled ? "" : setup.value,
        accounting_team_size: team.value,
        which_best_describes_you: role.value,
        contact_source: form.dataset.contactSource || "Tally Self Onboarding",
        campaign: "tally-self-onboarding",
        lead_reference: window.LEAD_REFERENCE || "",
        lr_hpf_x7: honeypot?.value || "",
        __page: location.href,
        ...utm,
        ...clickIds,
      };
      Object.keys(payload).forEach((k) => { if (!payload[k]) delete payload[k]; });

      // Bot trap filled: same as the Meta page, no router call (no GM turn used) and nothing sent to HubSpot.
      if (payload.lr_hpf_x7) { window.location.assign(buildSignupUrl(payload)); return; }

      // Anything but Tally / Both: no router, no redirect. The lead is recorded via the legacy lead webhook (same
      // blocked-tool event the other LP forms use) and the form card swaps to a thank-you message in place.
      const toolNorm = tool.value.toLowerCase().split(":")[0].trim();
      if (!SIGNUP_TOOLS.includes(toolNorm)) {
        try {
          fetch(LEGACY_WEBHOOK, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...payload, __event: "form_submit_blocked_tool" }), keepalive: true,
          }).catch((err) => console.error("[self-onboarding] blocked-tool webhook failed", err));
        } catch (err) { console.error("[self-onboarding] blocked-tool webhook failed", err); }
        showSuccess();
        return;
      }

      // 1. Owner + token. routeLead never throws and caps itself at 4s; guard anyway so 2 and 3 always run.
      let result: Awaited<ReturnType<typeof routeLead>> = null;
      try {
        result = await routeLead({
          pageKey: form.dataset.pageKey || "tally-self-onboarding",
          email: payload.email, name: fullName, phone: phone10,
          fields: payload, utm, clickIds,
        });
        if (!result || !result.ok) console.error("[self-onboarding] routeLead returned no owner", result);
      } catch (err) {
        console.error("[self-onboarding] routeLead failed", err);
      }

      // 2. HubSpot via n8n. Fire and forget: keepalive lets it finish after we navigate away.
      try { sendToRouterWebhook(payload, result); }
      catch (err) { console.error("[self-onboarding] router webhook failed", err); }

      // 3. Sign-up page, pre-filled. Allowlisted params only.
      // The sign-up page prefills only for utm_source=meta, so the link always says meta.
      // (HubSpot above still gets the visitor's real UTMs.)
      window.location.assign(buildSignupUrl({ ...payload, utm_source: SIGNUP_UTM_SOURCE }));
    });

    // bfcache: coming back from the sign-up page must give a usable form again.
    window.addEventListener("pageshow", (ev) => {
      if (ev.persisted) { submitting = false; btn.disabled = false; btn.textContent = "Start Free Trial"; }
    });
  };

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init, { once: true });
  else init();
</script>
