---

<!-- Section 4: Urgency CTA Banner (Slightly Pointy Corners) -->
<section class="py-16 md:py-20 bg-purple-50/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-b from-purple-100/50 to-indigo-100/60 rounded-xl p-10 sm:p-16 text-center shadow-sm relative border border-purple-200/50">
      
      <div class="max-w-xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-950 tracking-tight leading-tight mb-4">
          Slots fill fast.<br />
          Don't lose yours.
        </h2>
        
        <p class="text-base sm:text-lg text-slate-600 font-medium mb-8">
          Book the Demo and See how AIAccountant works, today.
        </p>

        <div class="flex justify-center">
          <a href="#hero" id="astro-cta-btn" class="inline-flex items-center justify-center bg-slate-950 hover:bg-black text-white font-extrabold text-base px-8 py-3.5 rounded border border-slate-950 shadow transition-all hover:scale-[1.02]">
            Book a demo
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctaBtn = document.getElementById('astro-cta-btn');
    if (ctaBtn) {
      ctaBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const heroForm = document.getElementById('lead-form-container');
        if (heroForm) {
          heroForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
          // The two hero variants prefix their fields differently.
          const nameField =
            document.getElementById('astro-first_name') ||
            document.getElementById('generic-first_name');
          if (nameField) nameField.focus({ preventScroll: true });
        }
      });
    }
  });
</script>
