---
// Test variant B: ultra-clean centered single-column hero. Whitespace does the work.
---

<header class="relative pt-6 pb-12 lg:pt-14 lg:pb-16 bg-white" id="hero">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto flex flex-col items-center">
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-black leading-[1.05] lg:leading-[1.1] tracking-tighter mb-4 lg:mb-6 text-center text-slate-950"
      >
        <span class="block text-red-600">3 days left</span>
        <span class="inline lg:block mt-1 lg:mt-4">
          to get
        </span>
        <span class="inline lg:block lg:mt-5 underline decoration-purple-500 decoration-4 underline-offset-4">
          40% off*
        </span>
      </h1>

      <p
        class="hidden lg:block text-lg text-slate-600 font-normal leading-relaxed mb-8 max-w-xl text-center"
      >
        Effortlessly integrate with Tally using our AI Accountant to streamline
        workflows, reduce manual errors, and gain real-time financial insights
        – empowering you to focus on growth and smarter decisions.
      </p>

      <!-- Form -->
      <div class="w-full max-w-md" id="lead-form-container">
        <div
          class="bg-white ring-1 ring-slate-200 rounded-2xl p-4 sm:p-6 shadow-xl shadow-slate-200/70 relative"
        >
          <div
            class="flex items-center justify-between gap-2 mb-3 lg:mb-4 pb-2.5 lg:pb-3 border-b border-slate-100"
          >
            <h2
              class="text-lg sm:text-xl font-black text-slate-950 tracking-tight"
            >
              Book A Demo
            </h2>
            <span
              class="inline-flex items-center gap-1 bg-purple-50 text-purple-900 text-xs font-bold px-2.5 py-1 rounded-full border border-purple-200"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-purple-600 animate-pulse"
              ></span>
              40 slots available
            </span>
          </div>

          <form id="vbLeadForm" class="space-y-2.5 lg:space-y-3" novalidate>
            <div>
              <input
                type="text"
                id="vb-first_name"
                name="first_name"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all"
                placeholder="Name *"
                required
              />
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-first_name-error">Please enter your name</span
              >
            </div>

            <div>
              <input
                type="email"
                id="vb-email"
                name="email"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all"
                placeholder="Email Address *"
                required
              />
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-email-error">Please enter a valid email address</span
              >
            </div>

            <div>
              <div class="flex items-center">
                <span
                  class="inline-flex items-center px-3.5 h-11 sm:h-12 bg-slate-50 border border-r-0 border-slate-300 rounded-l-xl text-slate-700 text-sm lg:text-base font-bold select-none shrink-0"
                >
                  +91
                </span>
                <input
                  type="tel"
                  id="vb-lg__phone"
                  name="lg__phone"
                  maxlength="10"
                  inputmode="numeric"
                  class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-r-xl text-slate-900 text-sm lg:text-base font-semibold placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all"
                  placeholder="Phone number *"
                  required
                />
              </div>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-lg__phone-error"
                >Phone number must be exactly 10 digits</span
              >
            </div>

            <div>
              <select
                id="vb-which_accounting_tool_do_you_use"
                name="which_accounting_tool_do_you_use"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected
                  >Which accounting tool do you use? *</option
                >
                <option value="Tally">Tally</option>
                <option value="Both">Both</option>
                <option value="Zoho Books">Zoho Books</option>
                <option value="Others">Others</option>
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-which_accounting_tool_do_you_use-error"
                >Please select your accounting tool</span
              >
            </div>

            <div>
              <select
                id="vb-accounting_team_size"
                name="accounting_team_size"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected>Team size *</option>
                <option value="0">0</option>
                <option value="1-3">1-3</option>
                <option value="3-5">3-5</option>
                <option value="5-10">5-10</option>
                <option value="10+">10+</option>
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-accounting_team_size-error"
                >Please select team size</span
              >
            </div>

            <div>
              <select
                id="vb-which_best_describes_you"
                name="which_best_describes_you"
                class="w-full h-11 sm:h-12 px-3.5 bg-white border border-slate-300 rounded-xl text-slate-700 text-sm lg:text-base font-semibold focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-600/20 transition-all cursor-pointer"
                required
              >
                <option value="" disabled selected
                  >Which best describes you? *</option
                >
                <option value="CA firm: automating my clients' books"
                  >CA firm: automating my clients' books</option
                >
                <option
                  value="Business owner: automating my company's accounting"
                  >Business owner: automating my company's accounting</option
                >
                <option value="Finance team: looking to automate our books"
                  >Finance team: looking to automate our books</option
                >
                <option value="Channel partner: looking to resell AiA"
                  >Channel partner: looking to resell AiA</option
                >
              </select>
              <span
                class="text-xs font-semibold text-[#dc2626] hidden mt-1"
                id="vb-which_best_describes_you-error"
                >Please select your role</span
              >
            </div>

            <button
              type="submit"
              id="Tally-Automation"
              class="w-full h-12 sm:h-13 mt-1.5 lg:mt-2 bg-purple-600 hover:bg-purple-700 active:bg-purple-800 text-white font-extrabold text-base lg:text-lg rounded-xl shadow-lg shadow-purple-600/25 transition-all cursor-pointer flex items-center justify-center tracking-wide"
            >
              Submit
            </button>
            <span
              id="vb-general-error"
              class="text-xs font-semibold text-[#dc2626] hidden mt-2 text-center block"
            >
              Couldn't save your details. Please try again.
            </span>

            <p
              class="text-[10px] sm:text-xs text-slate-500 text-center pt-1 lg:pt-2 leading-tight font-medium"
            >
              By submitting this form, you agree to our <a
                href="https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/6a44d5f5042f7ab8d58990ad_Privacy%20Policy_AIA_6.0_300626%20%201%20(1).pdf"
                target="_blank"
                rel="noopener"
                class="text-purple-700 font-bold underline hover:text-purple-900"
                >Privacy Policy</a
              > and consent to being contacted.
            </p>
          </form>

          <div id="vbSuccessMessage" class="hidden text-center py-6">
            <div
              class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full inline-flex items-center justify-center mb-2"
            >
              <svg
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </div>
            <h3 class="text-lg font-black text-slate-950 mb-1">
              You're All Set!
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm font-semibold">
              Thank you for requesting a demo. Our team will contact you
              shortly.
            </p>
          </div>
        </div>

        <!-- Trust pills below the form so they never push it down -->
        <div
          class="flex justify-center flex-wrap items-center gap-1.5 mt-4"
        >
          <span
            class="text-[10px] sm:text-xs font-semibold text-slate-500 bg-slate-50 border border-slate-200 rounded-full px-2.5 py-1"
            >ISO Certified</span
          >
          <span
            class="text-[10px] sm:text-xs font-semibold text-slate-500 bg-slate-50 border border-slate-200 rounded-full px-2.5 py-1"
            >SOC 2 Type II Certified</span
          >
          <span
            class="text-[10px] sm:text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 rounded-full px-2.5 py-1"
            >300M+ Transactions Analyzed</span
          >
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { bindLeadForm } from "../scripts/leadForm";

  bindLeadForm({
    contactSource: "Tally Automation",
    defaultRouterId: "6506",
    channelPartnerRouterId: "6273",
    triggerSelector: "#Tally-Automation",
    webhookUrl:
      "https://aiacc.app.n8n.cloud/webhook/ce246056-bdd0-4199-b363-3b44ed255f96",
    blockedTools: ["Zoho Books", "Others"],
    webhookOnAllPaths: false,
    debug: true,

    formSelector: "#vbLeadForm",
    fieldIdPrefix: "vb-",
    successSelector: "#vbSuccessMessage",
    generalErrorSelector: "#vb-general-error",
  });
</script>
