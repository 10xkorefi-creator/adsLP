---
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const { 
  title = "AI Accountant for Tally Automation - Reduce 75% Manual Work", 
  description = "Effortlessly integrate with Tally using our AI Accountant to streamline workflows, reduce manual errors, and gain real-time financial insights.",
  bodyClass = "bg-slate-50 text-slate-900"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Font Optimization for Core Web Vitals (Plus Jakarta Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
</head>
<body class={`min-h-screen font-sans text-base overflow-x-hidden selection:bg-purple-500 selection:text-white ${bodyClass}`}>
  <slot />
</body>
</html>
