---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Seat Reserved - AI Accountant"
  description="Your seat is now reserved. We saved your spot with AI Accountant."
  bodyClass="bg-[#05030d] text-white"
>
  <main class="h-screen w-screen max-h-screen max-w-full overflow-hidden bg-[#05030d] text-white flex flex-col items-center justify-center p-4 sm:p-8 relative selection:bg-purple-600 selection:text-white">
    
    <!-- Seamless Radial Ambient Glow matching the dark purple/blue theme -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-purple-950/40 via-[#05030d]/90 to-[#05030d] pointer-events-none"></div>
    <div class="absolute w-[350px] sm:w-[550px] h-[350px] sm:h-[550px] bg-purple-600/12 rounded-full blur-[140px] pointer-events-none"></div>

    <!-- Centered Viewport Content (Zero Desktop Scroll, Lighter Font Contrast) -->
    <div class="relative z-10 flex flex-col items-center justify-center text-center max-w-3xl mx-auto my-auto py-2">
      
      <!-- Top Script Subheading in Light Glowing Lavender -->
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif italic text-purple-100/95 tracking-wide mb-4 sm:mb-6 leading-tight drop-shadow-[0_2px_10px_rgba(216,180,254,0.3)]">
        this seat is now reserved
      </h2>

      <!-- Generated 3D Reserved Chair Image Seamlessly Blended -->
      <div class="relative my-2 sm:my-4 flex items-center justify-center">
        <div class="absolute w-36 h-36 sm:w-52 sm:h-52 bg-purple-600/25 rounded-full blur-2xl animate-pulse"></div>
        <img 
          src="/reserved-chair-photo.png" 
          alt="Reserved Chair" 
          class="relative h-32 sm:h-44 md:h-52 w-auto object-contain max-h-[30vh] rounded-2xl drop-shadow-[0_12px_30px_rgba(168,85,247,0.35)] transition-transform duration-300 hover:scale-105"
        />
      </div>

      <!-- Main Headline in Pure Bright White -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-3 sm:mb-4 px-2 max-w-2xl drop-shadow-md">
        We saved your spot. Don't leave us hanging.
      </h1>

      <!-- Brand Subtext in Vibrant Light Violet -->
      <p class="text-xs sm:text-sm font-extrabold text-purple-300 tracking-[0.25em] uppercase">
        AI Accountant
      </p>

    </div>

  </main>
</Layout>
