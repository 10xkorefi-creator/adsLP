---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Seat Reserved - AI Accountant"
  description="Your seat is now reserved. We saved your spot with AI Accountant."
  bodyClass="bg-[#05030d] text-white"
>
  <main
    class="min-h-screen w-full overflow-x-hidden bg-[#05030d] text-white flex flex-col items-center justify-center p-4 sm:p-8 relative selection:bg-purple-600 selection:text-white py-12 sm:py-20"
  >
    <!-- Seamless Radial Ambient Glow matching the dark purple/blue theme -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-purple-950/40 via-[#05030d]/90 to-[#05030d] pointer-events-none fixed"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[550px] h-[350px] sm:h-[550px] bg-purple-600/12 rounded-full blur-[140px] pointer-events-none fixed"
    >
    </div>

    <!-- Centered Viewport Content -->
    <div
      class="relative z-10 flex flex-col items-center justify-center text-center w-full max-w-3xl mx-auto h-full py-1"
    >
      <!-- Top Script Subheading in Light Glowing Lavender -->
      <h2
        class="text-xl sm:text-4xl md:text-5xl font-serif italic text-purple-100/95 tracking-wide mb-2 sm:mb-6 leading-tight drop-shadow-[0_2px_10px_rgba(216,180,254,0.3)]"
      >
        this seat is now reserved
      </h2>

      <!-- Generated 3D Reserved Chair Image Seamlessly Blended -->
      <div class="relative my-2 sm:my-4 flex items-center justify-center">
        <div
          class="absolute w-24 h-24 sm:w-52 sm:h-52 bg-purple-600/25 rounded-full blur-2xl animate-pulse"
        >
        </div>
        <img
          src="/reserved-chair-photo.png"
          alt="Reserved Chair"
          class="relative h-24 sm:h-44 md:h-52 w-auto object-contain rounded-2xl drop-shadow-[0_12px_30px_rgba(168,85,247,0.35)] transition-transform duration-300 hover:scale-105"
        />
      </div>

      <!-- Main Headline in Pure Bright White -->
      <h1
        class="text-[26px] sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-normal leading-[1.2] sm:leading-snug mb-3 sm:mb-6 px-2 max-w-3xl drop-shadow-md"
      >
        We saved your spot.<br /> Don't leave us hanging.
      </h1>

      <!-- Brand Subtext in Vibrant Light Violet -->
      <p
        class="text-[10px] sm:text-sm font-extrabold text-purple-300 tracking-[0.25em] uppercase mb-6 sm:mb-12"
      >
        AI Accountant
      </p>

      <!-- Blog Section -->
      <div
        class="mt-2 sm:mt-4 w-full max-w-lg flex flex-col items-center px-2 sm:px-0"
      >
        <h3
          class="text-[10px] sm:text-sm font-semibold text-purple-300/80 mb-2 sm:mb-4 uppercase tracking-widest text-center"
        >
          While you wait for the demo, explore the possibilities
        </h3>

        <a
          href="https://www.aiaccountant.com/blog/tally-integration-with-ai-accountant"
          target="_blank"
          rel="noopener noreferrer"
          class="group block w-full bg-purple-900/10 hover:bg-purple-900/30 border border-purple-500/20 hover:border-purple-400/40 rounded-xl sm:rounded-2xl p-2.5 sm:p-4 transition-all duration-300 backdrop-blur-sm shadow-xl hover:shadow-purple-900/30 flex flex-row items-center gap-3 sm:gap-5 text-left"
        >
          <!-- Left Side: Title & Description -->
          <div class="flex-1 flex flex-col justify-center h-full py-1">
            <h4
              class="text-[13px] sm:text-lg font-bold text-white group-hover:text-purple-200 transition-colors mb-0.5 sm:mb-2 leading-snug line-clamp-1 sm:line-clamp-none"
            >
              Tally Integration with AI Accountant
            </h4>
            <p
              class="text-[10px] sm:text-sm text-purple-200/60 line-clamp-2 leading-snug sm:leading-relaxed"
            >
              See how our AI fully automates your Tally bookkeeping.
            </p>
            <div
              class="mt-1 sm:mt-2 inline-flex items-center text-[9px] sm:text-xs font-extrabold text-purple-400 group-hover:text-purple-300 uppercase tracking-widest transition-colors"
            >
              Read Article
              <svg
                class="w-3 h-3 sm:w-3.5 sm:h-3.5 ml-1 sm:ml-1.5 transform group-hover:translate-x-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </div>

          <!-- Right Side: Image -->
          <div
            class="w-20 h-20 sm:w-32 sm:h-32 rounded-lg sm:rounded-xl shrink-0 overflow-hidden relative shadow-inner"
          >
            <img
              src="/tally-int.webp"
              alt="Tally Integration with AI Accountant"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>
