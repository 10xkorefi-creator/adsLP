---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import WhatsappHero from '../components/whatsapp/WhatsappHero.astro';
import WhatsappValueProps from '../components/whatsapp/WhatsappValueProps.astro';
import WhatsappHowItWorks from '../components/whatsapp/WhatsappHowItWorks.astro';
import WhatsappWhy from '../components/whatsapp/WhatsappWhy.astro';
import WhatsappFAQ from '../components/whatsapp/WhatsappFAQ.astro';
import WhatsappWaitlistForm from '../components/whatsapp/WhatsappWaitlistForm.astro';
import WhatsappStickyBanner from '../components/whatsapp/WhatsappStickyBanner.astro';

const title = "Chat with your accounting data on WhatsApp | AI Accountant";
const description = "Cash in hand, who owes you money, today's sales. Ask AI Accountant on WhatsApp and get a straight answer in seconds. Connected to your Tally.";
---

<Layout title={title} description={description} bodyClass="bg-slate-50 text-slate-900 scroll-smooth">
  <main>
    <!-- Navbar with integrated 'Free forever' banner -->
    <nav class="w-full bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 sm:h-20">
          <!-- Logo -->
          <a href="https://www.aiaccountant.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <img src="/korefi-logo.png" alt="AI Accountant Logo" class="h-8 sm:h-10 w-auto" />
            <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900">AI Accountant</span>
          </a>
          
          <!-- Banner Text & CTA (Desktop) -->
          <div class="hidden md:flex items-center gap-6">
            <p class="text-[#25D366] font-bold text-sm lg:text-base animate-pulse">
              ✨ Free forever for the first 100 users!
            </p>
            <button onclick="window.openWaitlistModal()" class="bg-[#25D366] hover:bg-[#1DA851] text-white font-bold px-6 py-2.5 rounded-full shadow-lg shadow-[#25D366]/20 transition-transform hover:-translate-y-0.5">
              Join Waitlist
            </button>
          </div>

          <!-- CTA (Mobile) -->
          <div class="md:hidden flex items-center">
            <button onclick="window.openWaitlistModal()" class="bg-[#25D366] hover:bg-[#1DA851] text-white font-bold text-sm px-4 py-2 rounded-full shadow-md">
              Waitlist
            </button>
          </div>
        </div>
      </div>
      <!-- Mobile Banner Text -->
      <div class="md:hidden bg-slate-50 border-t border-slate-100 py-2 text-center">
         <p class="text-[#25D366] font-bold text-xs animate-pulse">
           ✨ Free forever for the first 100 users!
         </p>
      </div>
    </nav>
    <WhatsappHero />
    <WhatsappValueProps />
    <WhatsappHowItWorks />
    <WhatsappWhy />
    <WhatsappFAQ />
    <WhatsappWaitlistForm contactSource="WA bot - Organic" showTallyReadyMessage={false} hideHeaderOnSuccess={false} />
  </main>
  
  <Footer hideTestimonials={true} />
</Layout>
