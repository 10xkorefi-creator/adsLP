---
// Self-onboarding LP: visitor fills the form here, lead is routed to an owner in HubSpot,
// then they land on app.aiaccountant.com/sign-up with the form pre-filled (see scripts/signupRedirect.ts).
// Mostly mobile traffic: designed phone-first, desktop layered on with lg: classes.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SelfOnboardingForm from '../components/self-onboarding/SelfOnboardingForm.astro';
import SelfOnboardingTestimonials from '../components/self-onboarding/SelfOnboardingTestimonials.astro';

import afkLogo from '../assets/logos/afkgaming.avif';
import buildTrustLogo from '../assets/logos/buildtrust.avif';
import cuttingLogo from '../assets/logos/cutting.avif';
import kettoLogo from '../assets/logos/ketto.avif';
import newtonLogo from '../assets/logos/newtonschool.avif';
import tripIndiaLogo from '../assets/logos/tripindia.avif';
import uplersLogo from '../assets/logos/uplers.avif';

const title = "Let AI do your Tally entries | AI Accountant";
const description = "Forward bills on WhatsApp, upload bank statements, and get entries ready for Tally with ledger and GST filled in. Start a free trial on your own Tally data.";

const logos = [
  { src: afkLogo.src, alt: 'AFK Gaming' },
  { src: buildTrustLogo.src, alt: 'Build Trust' },
  { src: cuttingLogo.src, alt: 'Cutting' },
  { src: kettoLogo.src, alt: 'Ketto' },
  { src: newtonLogo.src, alt: 'Newton School' },
  { src: tripIndiaLogo.src, alt: 'Trip India' },
  { src: uplersLogo.src, alt: 'Uplers' },
];

const rows = [
  {
    label: 'Purchase bills',
    today: 'Bills pile up on WhatsApp and email. Someone types each one into Tally, line by line.',
    withAia: 'Forward the bill on WhatsApp. It comes back as a purchase entry with the ledger and GST already filled in, ready for your accountant to push to Tally.',
  },
  {
    label: 'Bank statements',
    today: 'Hundreds of bank entries a month, entered and matched by hand. Always the last job to get done.',
    withAia: 'Upload the statement. Every entry is mapped to the right ledger and matched to its invoice.',
  },
  {
    label: 'GST reconciliation',
    today: 'Books matched against GSTR-2B in Excel the day before filing. Mismatches slip through and ITC goes unclaimed.',
    withAia: "Mismatches are flagged as entries come in, so you claim your full ITC and filing day isn't a scramble.",
  },
];

const stats = [
  { value: '48,000+', label: 'bills processed last month' },
  { value: '89%', label: 'of bank entries categorised automatically' },
  { value: '₹4.2 Cr', label: 'in ITC mismatches flagged' },
];

const steps = [
  { title: 'Sign up in 2 minutes.', body: '' },
  {
    title: 'If your accountant manages Tally,',
    body: 'invite them after you sign up, and they set it up in about 10 minutes from the computer where Tally runs. If you handle Tally yourself, you can do the integration yourself.',
  },
  { title: 'Nothing to switch.', body: 'It works on top of TallyPrime, and your books stay in Tally.' },
  { title: 'Nothing goes in unchecked.', body: 'You review every entry before it goes into Tally.' },
];

const chips = ['500+ businesses', '300M+ transactions processed', 'ISO & SOC 2 Type II certified'];
---

<Layout title={title} description={description} bodyClass="bg-white text-black">
  <div class="so-page">
    <!-- Nav -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-neutral-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 lg:h-16 flex items-center justify-between">
        <a href="https://www.aiaccountant.com/" target="_blank" rel="noopener" class="flex items-center gap-2">
          <img src="/korefi-logo.png" alt="" class="h-7 lg:h-8 w-auto" />
          <span class="text-lg lg:text-xl font-bold">AI Accountant</span>
        </a>
        <a href="#start" data-focus-form class="hidden sm:inline-flex items-center h-10 px-5 rounded-md bg-[#314DD0] hover:bg-[#2a42b5] text-white font-bold text-sm transition">Start Free Trial</a>
      </div>
    </nav>

    <main>
      <!-- Fold 1: Hero -->
      <section class="pt-6 pb-10 lg:pt-16 lg:pb-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start">
          <div class="lg:col-span-6 lg:pt-6">
            <h1 class="text-[2.5rem] sm:text-5xl lg:text-6xl font-bold leading-[1.05]">
              Let AI do your <span class="text-[#314DD0]">Tally</span> entries.
            </h1>
            <p class="mt-3 lg:mt-5 text-base lg:text-lg text-neutral-600 leading-relaxed max-w-xl">
              Effortlessly integrate with Tally using our AI Accountant to streamline workflows, reduce manual errors, and gain real-time financial insights, empowering you to focus on growth and smarter decisions.
            </p>
            <ul class="mt-4 lg:mt-6 flex flex-wrap gap-x-4 gap-y-2 lg:gap-2" aria-label="Proof points">
              {chips.map((chip) => (
                <li class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-800 lg:rounded-full lg:border lg:border-neutral-300 lg:px-3.5 lg:py-1.5">
                  <svg class="w-4 h-4 text-[#314DD0] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                  {chip}
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-6 scroll-mt-20" id="start">
            <div class="-mx-4 sm:mx-0 border-y sm:border border-neutral-200 sm:rounded-xl bg-white px-4 py-5 sm:p-7 shadow-[0_8px_30px_rgba(0,0,0,0.06)]">
              <h2 class="text-xl lg:text-2xl font-bold mb-4">Try it on your own Tally data</h2>
              <SelfOnboardingForm />
            </div>
          </div>
        </div>
      </section>

      <!-- Logo row -->
      <section class="py-8 lg:py-10 border-y border-neutral-200 bg-neutral-50 overflow-hidden">
        <h2 class="px-4 text-center text-base lg:text-lg font-bold text-neutral-800">500+ businesses have switched to AI Accountant</h2>
        <!-- Mobile: auto-scrolling strip -->
        <div class="lg:hidden mt-5 relative">
          <div class="absolute inset-y-0 left-0 w-10 bg-gradient-to-r from-neutral-50 to-transparent z-10 pointer-events-none"></div>
          <div class="absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-neutral-50 to-transparent z-10 pointer-events-none"></div>
          <ul class="so-marquee flex gap-3 w-max" aria-label="Customer logos">
            {[...logos, ...logos].map((logo, i) => (
              <li class="w-28 h-14 shrink-0 rounded-lg border border-neutral-200 bg-white flex items-center justify-center p-2.5" aria-hidden={i >= logos.length ? 'true' : undefined}>
                <img src={logo.src} alt={i >= logos.length ? '' : logo.alt} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
              </li>
            ))}
          </ul>
        </div>
        <!-- Desktop: one row -->
        <ul class="hidden lg:grid max-w-6xl mx-auto px-6 mt-6 grid-cols-7 gap-3">
          {logos.map((logo) => (
            <li class="h-16 rounded-lg border border-neutral-200 bg-white flex items-center justify-center p-3">
              <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
            </li>
          ))}
        </ul>
      </section>

      <!-- Fold 2: What changes -->
      <section class="py-12 lg:py-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 class="text-[1.75rem] leading-tight sm:text-4xl font-bold max-w-2xl">What your accounts team stops struggling with</h2>

          <!-- Desktop table -->
          <div class="hidden md:block mt-10 overflow-hidden rounded-xl border border-neutral-200">
            <table class="w-full text-left">
              <thead class="bg-neutral-50 text-sm">
                <tr>
                  <th scope="col" class="w-[22%] px-6 py-4"><span class="sr-only">Task</span></th>
                  <th scope="col" class="w-[36%] px-6 py-4 font-bold text-neutral-600">Today</th>
                  <th scope="col" class="px-6 py-4 font-bold text-[#314DD0]">With AI Accountant</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-200">
                {rows.map((r) => (
                  <tr class="align-top">
                    <th scope="row" class="px-6 py-6 font-bold">{r.label}</th>
                    <td class="px-6 py-6 text-neutral-600 leading-relaxed">{r.today}</td>
                    <td class="px-6 py-6 text-black leading-relaxed bg-[#314DD0]/[0.03]">{r.withAia}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile cards: before / after -->
          <div class="md:hidden mt-6 space-y-4">
            {rows.map((r) => (
              <article class="rounded-xl border border-neutral-200 overflow-hidden">
                <h3 class="px-4 pt-4 font-bold text-lg">{r.label}</h3>
                <div class="px-4 pt-2 pb-4">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-neutral-500">Today</p>
                  <p class="mt-1 text-[15px] text-neutral-600 leading-relaxed">{r.today}</p>
                </div>
                <div class="px-4 py-4 bg-[#314DD0]/[0.05] border-t border-[#314DD0]/15">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-[#314DD0]">With AI Accountant</p>
                  <p class="mt-1 text-[15px] leading-relaxed">{r.withAia}</p>
                </div>
              </article>
            ))}
          </div>

          <!-- Stats -->
          <dl class="mt-6 lg:mt-8 grid grid-cols-1 sm:grid-cols-3 rounded-xl border border-neutral-200 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200">
            {stats.map((s) => (
              <div class="flex sm:flex-col items-center sm:items-start gap-4 sm:gap-1 px-4 py-4 sm:px-6 sm:py-5">
                <dt class="sr-only">{s.label}</dt>
                <dd class="w-28 sm:w-auto shrink-0 text-2xl lg:text-3xl font-bold text-[#314DD0] tabular-nums">{s.value}</dd>
                <dd class="text-sm text-neutral-600 leading-snug">{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- Fold 3: Easy to start -->
      <section class="py-12 lg:py-20 bg-black text-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 class="text-[1.75rem] leading-tight sm:text-4xl font-bold">Easy to start, nothing to change</h2>
          <ol class="mt-8 lg:mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 lg:gap-y-8">
            {steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-8 h-8 rounded-full bg-[#314DD0] flex items-center justify-center font-bold text-sm">{i + 1}</span>
                <p class="text-base lg:text-lg leading-relaxed text-neutral-300 pt-0.5"><strong class="text-white">{s.title}</strong> {s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Fold 4: Proof + closing CTA -->
      <SelfOnboardingTestimonials />
      <section id="so-closing" class="py-12 lg:py-16 text-center">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <a href="#start" data-focus-form class="flex sm:inline-flex items-center justify-center h-14 px-10 rounded-md bg-[#314DD0] hover:bg-[#2a42b5] text-white font-bold text-lg transition">Start Free Trial</a>
          <p class="mt-3 text-neutral-600">(No card required)</p>
        </div>
      </section>
    </main>

    <div id="so-footer"><Footer hideTestimonials={true} /></div>

    <!-- Mobile sticky CTA: appears once the form is off screen, hides near the closing CTA -->
    <div id="so-sticky" class="lg:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 bg-white/95 backdrop-blur border-t border-neutral-200 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]" aria-hidden="true">
      <a href="#start" data-focus-form tabindex="-1" class="flex items-center justify-center h-12 rounded-md bg-[#314DD0] text-white font-bold text-base">Start Free Trial · No card needed</a>
    </div>
  </div>
</Layout>

<style>
  .so-page {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  .so-page :global(h1),
  .so-page :global(h2) {
    letter-spacing: -0.04em;
  }
  .so-marquee {
    animation: so-marquee 28s linear infinite;
  }
  @keyframes so-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 0.375rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .so-marquee { animation: none; }
  }
</style>

<script>
  // CTA buttons jump to the form and put the cursor in the first field.
  document.querySelectorAll<HTMLAnchorElement>("[data-focus-form]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("start")?.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => (document.getElementById("so-first_name") as HTMLInputElement | null)?.focus({ preventScroll: true }), 500);
    });
  });

  // Sticky CTA (mobile): show when the form, the closing CTA and the footer are all off screen.
  const sticky = document.getElementById("so-sticky");
  const watched = ["start", "so-closing", "so-footer"].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sticky && watched.length && "IntersectionObserver" in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target) : visible.delete(en.target)));
      const show = visible.size === 0;
      sticky.classList.toggle("translate-y-full", !show);
      sticky.setAttribute("aria-hidden", show ? "false" : "true");
      sticky.querySelector("a")?.setAttribute("tabindex", show ? "0" : "-1");
    });
    watched.forEach((el) => io.observe(el));
    // After an in-form thank-you, "Start Free Trial" has nothing left to do: retire the sticky bar.
    window.addEventListener("so:lead-done", () => {
      io.disconnect();
      sticky.classList.add("translate-y-full");
      sticky.setAttribute("aria-hidden", "true");
      sticky.querySelector("a")?.setAttribute("tabindex", "-1");
    });
  }
</script>
