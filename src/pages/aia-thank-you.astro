---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank You - Free Trial Booked | AI Accountant">
  <main class="min-h-screen bg-slate-50 flex items-center justify-center p-6">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-sm border border-slate-200 p-8 text-center">
      <!-- Success Icon -->
      <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-emerald-100 mb-6">
        <svg class="h-10 w-10 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>

      <!-- Heading -->
      <h1 class="text-3xl font-black text-slate-950 mb-4 tracking-tight">
        Free Trial Booked!
      </h1>

      <!-- Message -->
      <p class="text-slate-600 text-lg leading-relaxed mb-2">
        Please <span class="bg-purple-100 text-purple-900 font-bold px-2 py-0.5 rounded">have Tally ready</span> before the call for easy onboarding.
      </p>
      
      <!-- Back to Home Link (Optional but good UX) -->
      <div class="mt-8">
        <a href="https://aiaccountant.com/" class="inline-flex justify-center items-center rounded-lg bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950 transition-all">
          Back to Home
        </a>
      </div>
    </div>
  </main>
</Layout>
