---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import WhatsappHero from '../components/whatsapp/WhatsappHero.astro';
import WhatsappValueProps from '../components/whatsapp/WhatsappValueProps.astro';
import WhatsappHowItWorks from '../components/whatsapp/WhatsappHowItWorks.astro';
import WhatsappWhy from '../components/whatsapp/WhatsappWhy.astro';
import WhatsappFAQ from '../components/whatsapp/WhatsappFAQ.astro';
import WhatsappWaitlistForm from '../components/whatsapp/WhatsappWaitlistForm.astro';

const title = "Chat with your accounting data on WhatsApp | AI Accountant";
const description = "Cash in hand, who owes you money, today's sales. Ask AI Accountant on WhatsApp and get a straight answer in seconds. Connected to your Tally.";
---

<Layout title={title} description={description} bodyClass="bg-slate-50 text-slate-900 scroll-smooth">
  <main>
    <WhatsappHero />
    <WhatsappValueProps />
    <WhatsappHowItWorks />
    <WhatsappWhy />
    <WhatsappFAQ />
    <WhatsappWaitlistForm />
  </main>
  
  <Footer />
</Layout>
