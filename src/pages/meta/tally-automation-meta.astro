---
// src/pages/gads/tally-automation-meta.astro
import Layout from '../../layouts/Layout.astro';
import MetaHero from '../../components/campaigns/MetaHero.astro';
import TheProblem from '../../components/campaigns/TheProblem.astro';
import TheOutcome from '../../components/campaigns/TheOutcome.astro';
import HowItWorks from '../../components/campaigns/HowItWorks.astro';
import Testimonials from '../../components/Testimonials.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';

const title = "Stop entering bank statements by hand | AI Accountant";
const description = "There is a faster way. AI Accountant does the data entry for you, so you don't lose your evenings at month-end.";
---

<Layout title={title} description={description} bodyClass="bg-slate-50 text-slate-900 scroll-smooth">
  <main>
    <MetaHero />
    <TheProblem />
    <TheOutcome />
    <HowItWorks />
    
    <Testimonials 
      customTitle="Businesses like yours have already switched" 
      customSubtitle=" "
      curatedAuthors={["Nishu B.", "Dhruvin Patel", "Pragya Chandra"]} 
    />
    
    <!-- Offer / Closing CTA -->
    <section class="py-16 md:py-24 bg-slate-50 relative overflow-hidden">
      <!-- Decorative background glow -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-100/40 via-transparent to-transparent -z-10"></div>
      
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-950 rounded-3xl p-8 sm:p-12 lg:p-16 shadow-2xl relative overflow-hidden border border-slate-800 transform hover:-translate-y-1 transition-transform duration-500">
          
          <!-- Abstract Background Elements for Premium Feel -->
          <div class="absolute top-0 right-0 -mr-20 -mt-20 w-72 h-72 rounded-full bg-purple-600/30 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-72 h-72 rounded-full bg-red-600/20 blur-3xl"></div>

          <div class="relative z-10 flex flex-col items-center text-center">
            
            <!-- Main Headline -->
            <h2 class="text-[2.25rem] leading-[1.1] sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight mb-10 flex flex-col items-center">
              <span class="block mb-5 text-slate-300 text-xl sm:text-2xl lg:text-3xl uppercase tracking-wider font-extrabold">Want to stop doing it by hand?</span>
              <span class="block mb-2 text-center flex flex-wrap justify-center items-center gap-x-2 gap-y-3">
                <span>Get</span>
                <span class="relative inline-block px-3 py-1 sm:px-4 sm:py-2 mx-1 whitespace-nowrap">
                  <span class="absolute inset-0 bg-[#FFE81A] transform -skew-x-6 rounded-md shadow-[4px_4px_0px_0px_rgba(239,68,68,1)] border-2 border-[#FFE81A]"></span>
                  <span class="relative text-slate-950 block text-[2.75rem] sm:text-[3.5rem] lg:text-[4.5rem] tracking-tighter leading-none mt-1">40% off*</span>
                </span>
              </span>
              <span class="block mt-4 sm:mt-2">when you start now.</span>
            </h2>

            <!-- CTA Button -->
            <a href="#hero" class="group relative inline-flex items-center justify-center px-8 py-4 sm:px-10 sm:py-5 text-lg sm:text-xl font-extrabold text-slate-950 bg-white rounded-xl overflow-hidden transition-all hover:scale-[1.02] hover:shadow-[0_0_40px_rgba(168,85,247,0.4)]">
              <span class="relative z-10 flex items-center gap-2">
                Book a demo
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </span>
              <!-- Hover effect background -->
              <div class="absolute inset-0 bg-gradient-to-r from-purple-100 to-red-100 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </a>

            <!-- Disclaimer -->
            <p class="mt-8 text-slate-400 text-sm font-medium">
              *Offer applicable for annual plans
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
