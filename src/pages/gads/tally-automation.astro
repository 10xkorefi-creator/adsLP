---
// /gads/tally-automation – Google Ads Tally automation LP.
// Built from the "Tally Automation – Google Ads Landing Page Prototype" design (mobile 390px primary + desktop 1440px).
// Form (26 Nov, same as self-onboarding): Tally / Both -> router + HubSpot -> pre-filled sign-up page;
// 5+ accountants (not CA firm / channel partner) -> Deb's WhatsApp card; any other tool -> in-form thank-you.
import Layout from '../../layouts/Layout.astro';
import afkLogo from '../../assets/logos/afkgaming.avif';
import buildTrustLogo from '../../assets/logos/buildtrust.avif';
import cuttingLogo from '../../assets/logos/cutting.avif';
import kettoLogo from '../../assets/logos/ketto.avif';
import newtonLogo from '../../assets/logos/newtonschool.avif';
import tripIndiaLogo from '../../assets/logos/tripindia.avif';
import uplersLogo from '../../assets/logos/uplers.avif';

const accent = '#2E45D6';
const headline = 'Stop Typing Bills Manually in Tally';
const sub = 'Upload handwritten bills or PDFs. AI Accountant extracts every detail, maps it to the right ledgers, and prepares your Tally entries.';
const bullets = ['Upload hundreds of bills at once', 'Bank statements reconciled in minutes', 'Review entries before posting to Tally'];
// Capterra rating: 4.71 from 14 reviews, https://www.capterra.com/p/10030073/AI-Accountant/ (checked 25 Nov 2026). Badge is not a link.
const VIDEO_ID = 'c0PIguVVOI4'; // "Automate Tally Bill Entries with AI Accountant" – official AI Accountant YouTube channel
const tools = ['Tally', 'Zoho Books', 'Both', 'SAP', 'Oracle NetSuite', 'Microsoft Dynamics 365', 'Odoo', 'Others'];

const trust = [
  { label: 'Live in 10 mins', sub: 'Connect your Tally and go', icon: 'M12 3a9 9 0 100 18 9 9 0 000-18zM12 7v5l3 2' },
  { label: 'From the Karbon Card team', sub: 'YC-backed fintech builders', icon: 'M3 7h18v10H3zM3 11h18' },
  { label: 'Bank-grade security', sub: 'SOC 2 Type II & ISO 27001 certified', icon: 'M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 017 0v3' },
  { label: '3-day free trial', sub: 'No credit card required', icon: 'M5 12.5l4.5 4.5L19 7.5' },
];
// Customer logos, original colours (same files as the other LPs + the Webflow logo strip).
const logos = [
  { src: uplersLogo.src, alt: 'Uplers' },
  { src: kettoLogo.src, alt: 'Ketto' },
  { src: '/urbanwatch.png', alt: 'UrbanMatch' },
  { src: cuttingLogo.src, alt: 'Cutting Edge Design Studio' },
  { src: '/snazzy-logo.png', alt: 'Snazzy' },
  { src: tripIndiaLogo.src, alt: 'Trip India' },
  { src: buildTrustLogo.src, alt: 'Acviss' },
  { src: '/virtual-tech-logo.png', alt: 'Virtual Tech' },
  { src: newtonLogo.src, alt: 'Newton School' },
  { src: '/subhag.png', alt: 'SUBHAG' },
  { src: afkLogo.src, alt: 'AFK Gaming' },
  { src: '/trifactorial.png', alt: 'Trifactorial Consulting' },
  { src: '/acc-n-more.png', alt: "Acc 'N' More" },
];
const steps = [
  { n: '01', title: 'Upload bills or bank statements', body: 'Snap a photo, upload a PDF or drop hundreds of files at once. Handwritten bills work too.' },
  { n: '02', title: 'AI extracts & categorises', body: 'Vendor, GSTIN, invoice details and line items are extracted, while AI suggests the appropriate ledgers.' },
  { n: '03', title: 'Review and post to Tally', body: 'Check the entries, then post them to Tally in one click. No retyping.' },
];
const quotes = [
  { initial: 'P', name: 'Pragya Chandra', role: 'Director of Business Development, Trip India', text: 'Tracking invoices and payments manually was a challenge for us. AI Accountant’s AP/AR Dashboard gives complete visibility into our bills and invoices, making reconciliation effortless.' },
  { initial: 'B', name: 'Bhupendra Singh', role: 'Managing Partner, Trifactorial Consulting LLP', text: 'AI Accountant makes it so much easier to move away from spreadsheets and have receivables and payables tracking in one place.' },
  { initial: 'D', name: 'Dhruvin Patel', role: 'CEO, Virtual Tech', text: 'The way it automatically matches transactions to invoices has saved us so much time.' },
  { initial: 'N', name: 'Nishu B.', role: 'Co-Founder, UrbanMatch', text: 'Expense categorization and bills automation simplify coordination with my CA.' },
];
const featured = quotes[0];
const others = quotes.slice(1);
const HIGHLIGHT = 'AI ledger categorisation'; // highlighted card in the design
const features = [
  { title: 'Bill & invoice entry', body: 'Photo or PDF in, Tally-ready entry out. Vendor, GST, line items, and suggested ledger captured automatically.', icon: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5' },
  { title: 'Bank statement to Tally', body: 'Any bank, any format. Transactions categorised and posted without Excel cleanup.', icon: 'M3 10l9-6 9 6M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18' },
  { title: 'Auto bank reconciliation', body: 'Matches bank entries to bills and invoices and flags what doesn’t match.', icon: 'M4 7h12l-3-3M20 17H8l3 3' },
  { title: 'AI ledger categorisation', body: 'Automatically suggests the right ledgers and learns from your corrections to improve accuracy over time.', icon: 'M4 4h9l7 7-9 9-7-7zM8.5 8.5h.01' },
  { title: 'GST 2B matching & TDS checks', body: 'Catch mismatches before filing, not after.', icon: 'M12 3l8 3v6c0 4.5-3.5 8-8 9-4.5-1-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5' },
  { title: 'Payables & receivables view', body: 'Every bill and invoice in one dashboard: what’s due, what’s paid, what’s overdue.', icon: 'M4 5h16v14H4zM4 10h16M8 15h3' },
];
const faqs = [
  ['Does it work with offline (local) Tally?', 'Yes. AI Accountant works with both online (cloud-hosted) and offline (local) Tally. You connect your Tally company in a few clicks, and approved entries are pushed to Tally in one click.'],
  ['Can it read handwritten and scanned bills?', 'Yes. It reads handwritten and scanned bills with 95% accuracy on handwritten bills, along with PDFs, Excel files and images.'],
  ['Is my business data safe?', 'Yes. AI Accountant is SOC 2 Type II and ISO 27001:2022 certified. Your data is stored on secure servers with encryption and is accessed only for authorised purposes.'],
  ['How does the free trial work?', 'You get a 3-day free trial, no credit card needed. Your 3 days start only once your Tally is connected, so setup time never eats into your trial.'],
  ['What happens after I submit the form?', 'Our team calls you right away, connects your Tally with you on the call, and your 3-day trial starts from there.'],
];
const TERMS = 'https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/69a92b7bd26f8cfca36689f6_Terms%20of%20Use%20-%20Final.pdf';
const PRIVACY = 'https://cdn.prod.website-files.com/67ed19ac5d8a1253defd2450/6a44d5f5042f7ab8d58990ad_Privacy%20Policy_AIA_6.0_300626%20%201%20(1).pdf';
const check = 'M4.5 12.5l5 5L19.5 7';
---

<Layout title="Stop typing bills manually in Tally | AI Accountant" description={sub} bodyClass="bg-white">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;700&display=swap" rel="stylesheet" />

  <div class="g" style={`--accent:${accent}`}>
    <!-- Header (sticky on phones and desktop) -->
    <header class="g-header">
      <div class="g-wrap g-header-in">
        <a class="g-brand" href="https://www.aiaccountant.com/" target="_blank" rel="noopener">
          <img class="g-logo" src="/korefi-logo.png" alt="" width="32" height="32" /><span class="g-brand-name">AI Accountant</span>
        </a>
        <a href="#form" class="g-btn g-header-cta" data-to-form>Start Free Trial</a>
      </div>
    </header>

    <main>
      <!-- 1. Hero + 2. Form -->
      <section class="g-hero">
        <div class="g-wrap g-hero-in">
          <div class="g-hero-copy">
            <div class="g-cap" role="img" aria-label="Rated 4.7 out of 5 on Capterra">
              <img class="g-cap-logo" src="/capterra-logo.svg" alt="Capterra" width="100" height="23" />
              <span class="g-cap-div" aria-hidden="true"></span>
              <span class="g-cap-txt">
                <span class="g-cap-row"><span class="g-cap-stars" aria-hidden="true">★★★★<span class="g-cap-part">★<span>★</span></span></span><span class="g-cap-score">4.7/5</span></span>
                <span class="g-cap-sub">Rated on Capterra</span>
              </span>
            </div>
            <h1 class="g-h1">{headline}</h1>
            <p class="g-sub">{sub}</p>

            <div class="g-bill-demo">
              <div class="g-note">
                <span class="g-note-t">Sharma Hardware</span>
                <span>Cement 50kg × 20 … 8,400</span>
                <span>GST 18% … 1,512</span>
                <span class="g-note-total">Total ₹9,912</span>
              </div>
              <svg aria-hidden="true" class="g-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M14 6l6 6-6 6"></path></svg>
              <div class="g-voucher">
                <span class="g-voucher-k"><span class="m-only">TALLY · PURCHASE</span><span class="d-only">TALLY · PURCHASE VOUCHER</span></span>
                <span class="g-voucher-n">Sharma Hardware</span>
                <span class="g-voucher-a">₹9,912.00</span>
                <span class="g-posted"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#146C3F" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Posted to Tally</span>
              </div>
            </div>

            <ul class="g-bullets">
              {bullets.map((b) => (
                <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={check}></path></svg><span>{b}</span></li>
              ))}
            </ul>
          </div>

          <div class="g-form-col">
            <div class="g-card" id="form">
              <form id="g-form" class="g-form" novalidate>
                <div class="g-form-head">
                  <span class="g-form-title">Start your free trial</span>
                  <span class="g-form-sub">Takes 30 seconds. We call you right away to set it up.</span>
                </div>

                <label class="g-f a-name">Full name
                  <input type="text" id="g-name" name="first_name" placeholder="e.g. Priya Mehta" autocomplete="name" maxlength="256" required />
                  <span class="g-err">Please enter your name.</span>
                </label>
                <label class="g-f a-email">Work email
                  <input type="email" id="g-email" name="email" placeholder="you@company.com" autocomplete="email" maxlength="256" required />
                  <span class="g-err">Please enter a valid email address.</span>
                </label>
                <label class="g-f a-phone">Phone number
                  <span class="g-phone"><span class="g-cc">+91</span><input type="tel" id="g-phone" name="lg__phone" inputmode="numeric" placeholder="98765 43210" autocomplete="tel-national" required /></span>
                  <span class="g-err">Enter a valid 10-digit number.</span>
                </label>
                <label class="g-f a-company">Company name
                  <input type="text" id="g-company" name="company" placeholder="e.g. Mehta Enterprises Pvt Ltd" autocomplete="organization" maxlength="256" required />
                  <span class="g-err">Please enter your company name.</span>
                </label>
                <label class="g-f a-tool"><span class="m-only">Accounting software you use</span><span class="d-only">Accounting software</span>
                  <select id="g-tool" name="which_accounting_tool_do_you_use" required>
                    <option value="" disabled selected>Select</option>
                    {tools.map((t) => <option value={t}>{t}</option>)}
                  </select>
                  <span class="g-err">Please select your accounting software.</span>
                </label>
                <label class="g-f a-setup" id="g-setup-wrap" hidden><span class="m-only">Is your Tally on cloud or local?</span><span class="d-only">Tally: cloud or local?</span>
                  <select id="g-setup" name="tally_setup" disabled>
                    <option value="" disabled selected>Select</option>
                    <option value="Offline">Offline (local system)</option>
                    <option value="Cloud-hosted">Cloud-hosted</option>
                    <option value="not-sure">Not sure</option>
                  </select>
                  <span class="g-err">Please select an option.</span>
                </label>
                <label class="g-f a-team">Team size
                  <select id="g-team" name="accounting_team_size" required>
                    <option value="" disabled selected>Select</option>
                    <option value="1-3">1-3</option>
                    <option value="3-5">3-5</option>
                    <option value="5-10">5-10</option>
                    <option value="10+">10+</option>
                  </select>
                  <span class="g-err">Please select team size.</span>
                </label>
                <label class="g-f a-role">You are a
                  <select id="g-role" name="which_best_describes_you" required>
                    <option value="" disabled selected>Select</option>
                    <option value="Business owner">Business owner</option>
                    <option value="finance team">Finance team</option>
                    <option value="CA firm">CA firm</option>
                    <option value="Channel partner">Channel partner</option>
                  </select>
                  <span class="g-err">Please select one.</span>
                </label>

                <input type="text" name="lr_hpf_x7" tabindex="-1" autocomplete="off" aria-hidden="true" class="g-hp" />

                <button type="submit" id="g-submit" class="g-btn g-submit a-submit">Start Free Trial →</button>
                <p class="g-legal a-legal">By submitting, you agree to our <a href={PRIVACY} target="_blank" rel="noopener">Privacy Policy</a> and consent to being contacted.</p>
              </form>

              <div id="g-success" class="g-success" hidden role="status" aria-live="polite" tabindex="-1">
                <span class="g-success-ic"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span>
                <span class="g-success-t">Thanks for submitting the Form</span>
                <span class="g-success-s">We will reach out to you</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Trust callouts -->
      <section class="g-trust">
        <div class="g-wrap g-trust-wrap">
          <div class="g-trust-in">
            {trust.map((t) => (
              <div class="g-trust-i">
                <span class="g-tile"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon}></path></svg></span>
                <span class="g-trust-txt"><span class="g-trust-l">{t.label}</span><span class="g-trust-s">{t.sub}</span></span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. Customer logos -->
      <section class="g-logos">
        <div class="g-wrap g-logos-in">
          <p class="g-eyebrow g-muted">500+ COMPANIES HAVE SWITCHED</p>
          <div class="g-marquee" aria-label="Customers">
            <ul class="g-logo-track">
              {[...logos, ...logos].map((l, i) => (
                <li aria-hidden={i >= logos.length ? 'true' : undefined}><img src={l.src} alt={i >= logos.length ? '' : l.alt} loading="lazy" decoding="async" /></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 5. How it works -->
      <section class="g-how">
        <div class="g-wrap g-how-in">
          <div class="g-how-copy">
            <div class="g-head">
              <h2 class="g-h2 g-h2-how">From a <span class="g-hw-note">crumpled bill</span> to a <span class="g-hw-chip">Tally entry<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#5FD49A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span></h2>
            </div>
            <ol class="g-steps">
              {steps.map((s) => (
                <li><span class="g-step-n">{s.n}</span><div><span class="g-step-t">{s.title}</span><span class="g-step-b">{s.body}</span></div></li>
              ))}
            </ol>
          </div>
          <div class="g-how-demo">
            <div class="g-video">
              <button type="button" class="g-video-btn" data-yt={VIDEO_ID} aria-label="Play video: Automate Tally bill entries with AI Accountant">
                <img src={`https://i.ytimg.com/vi/${VIDEO_ID}/sddefault.jpg`} alt="" loading="lazy" decoding="async" />
                <span class="g-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg></span>
              </button>
            </div>
            <p class="g-video-cap">Watch it work: bulk upload, OCR, GST and one-click sync to Tally</p>
          </div>
        </div>
      </section>

      <!-- 6. Testimonials -->
      <section class="g-stories">
        <div class="g-wrap g-sec">
          <div class="g-head">
            <h2 class="g-h2 g-h2-narrow">Businesses that stopped doing <span class="g-strike">data entry<svg aria-hidden="true" viewBox="0 0 100 24" preserveAspectRatio="none" fill="none"><path d="M2 15 C 20 8, 35 18, 52 10 S 85 6, 98 12" stroke="#E5484D" stroke-width="4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg></span></h2>
          </div>
          <div class="g-stories-in">
            <figure class="g-featured">
              <span aria-hidden="true" class="g-bigq">“</span>
              <blockquote>{featured.text}</blockquote>
              <figcaption><span class="g-line" aria-hidden="true"></span><span class="g-who"><span class="g-who-n">{featured.name}</span><span class="g-who-r">{featured.role}</span></span></figcaption>
            </figure>
            <div class="g-others">
              {others.map((q) => (
                <figure><blockquote>“{q.text}”</blockquote><figcaption><span class="g-who-n2">{q.name}</span> · {q.role}</figcaption></figure>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Features -->
      <section class="g-features">
        <div class="g-wrap g-sec">
          <div class="g-feat-head">
            <div class="g-head">
              <h2 class="g-h2 g-h2-feat">Everything your <span class="g-ul">Tally workflow<svg aria-hidden="true" viewBox="0 0 100 18" preserveAspectRatio="none" fill="none"><path d="M2 12 C 25 5, 55 3, 98 7 M 10 15 C 40 11, 70 11, 92 12" stroke="currentColor" stroke-width="4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg></span> needs</h2>
            </div>
            <p class="g-feat-more d-only">+ expense categorisation, custom reports, and more</p>
          </div>
          <div class="g-feat-grid">
            {features.map((f) => (
              <div class:list={["g-feat", { "g-feat-hl": f.title === HIGHLIGHT }]}>
                <span class="g-tile g-tile-feat"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon}></path></svg></span>
                <span class="g-feat-txt"><span class="g-feat-t">{f.title}</span><span class="g-feat-b">{f.body}</span></span>
              </div>
            ))}
          </div>
          <p class="g-feat-more m-only">+ expense categorisation, custom reports, and more</p>
        </div>
      </section>

      <!-- 8. FAQs -->
      <section class="g-faq">
        <div class="g-wrap g-sec g-faq-in">
          <h2 class="g-h2 g-faq-h">Questions, answered</h2>
          <div class="g-faq-list">
            {faqs.map(([q, a], i) => (
              <details open={i === 0}>
                <summary><span>{q}</span><span class="g-sign" aria-hidden="true"></span></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- 9. Final CTA -->
      <section class="g-final">
        <div class="g-wrap g-final-in">
          <div class="g-final-copy">
            <h2>Stop typing. Start closing books faster.</h2>
            <p>Join 500+ companies automating their Tally entries with AI Accountant.</p>
          </div>
          <a href="#form" class="g-final-cta" data-to-form>Start Free Trial →</a>
        </div>
      </section>
    </main>

    <footer class="g-footer">
      <div class="g-wrap g-footer-in">
        <div class="g-brand"><img class="g-logo g-logo-inv" src="/korefi-logo.png" alt="" width="28" height="28" /><span class="g-brand-name g-white">AI Accountant</span></div>
        <div class="g-footer-links">
          <a href={TERMS} target="_blank" rel="noopener">Terms</a>
          <a href={PRIVACY} target="_blank" rel="noopener">Privacy</a>
          <span class="g-footer-co">Korefi Business Solutions Private Limited<span class="m-only"> · All rights reserved.</span></span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* Design tokens from the prototype */
  .g { --ink:#0E0F12; --ink2:#2A2D34; --mut:#4A4E58; --mut2:#5A5F6B; --line:#E3E0D8; --line2:#DAD6CC; --field:#D6D3CB; --sand:#F6F4EF;
    font-family:'Inter Tight', system-ui, sans-serif; color:var(--ink); background:#fff; -webkit-font-smoothing:antialiased; }
  .g :global(*) { box-sizing:border-box; }
  .g a { color:var(--accent); }
  .g-wrap { max-width:1200px; margin:0 auto; padding:0 18px; }
  .d-only { display:none; }
  .g-eyebrow { font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.6px; margin:0; font-weight:500; }
  .g-muted { color:var(--mut2); font-size:10.5px; }
  .g-eyebrow-dark { color:#8C99E6; }
  .g-eyebrow-accent { color:var(--accent); }
  .g-head { display:flex; flex-direction:column; gap:8px; }
  .g-h2 { margin:0; font-size:28px; line-height:1.12; font-weight:800; letter-spacing:-.8px; }
  .g-btn { display:flex; align-items:center; justify-content:center; background:var(--accent); color:#fff !important; text-decoration:none; font-weight:600; border:0; cursor:pointer; font-family:inherit; }

  /* Header */
  .g-header { position:sticky; top:0; z-index:40; background:rgba(255,255,255,.96); border-bottom:1px solid var(--line); backdrop-filter:saturate(1.4) blur(6px); }
  .g-header-in { height:60px; padding:0 14px 0 18px; display:flex; align-items:center; justify-content:space-between; }
  .g-brand { display:flex; align-items:center; gap:8px; text-decoration:none; color:var(--ink) !important; }
  .g-mark { width:28px; height:28px; border-radius:7px; background:var(--ink); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; }
  .g-mark-inv { width:26px; height:26px; border-radius:6px; background:#fff; color:var(--ink); font-size:14px; }
  .g-brand-name { font-weight:700; font-size:16px; letter-spacing:-.2px; }
  .g-white { color:#fff; font-size:15px; }
  .g-header-cta { height:44px; padding:0 16px; border-radius:10px; font-size:14px; white-space:nowrap; }

  /* Hero */
  .g-hero { background:#fff; }
  .g-hero-in { padding:0; display:flex; flex-direction:column; }
  .g-hero-copy { padding:26px 18px 22px; background:var(--sand); display:flex; flex-direction:column; gap:12px; }
