  .g-trust-s { font-size:10.5px; line-height:1.35; color:var(--mut2); }

  /* Revolving customer logos (original colours) */
  .g-marquee { position:relative; overflow:hidden; margin:0 -20px; -webkit-mask-image:linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image:linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .g-logo-track { margin:0; padding:4px 0; list-style:none; display:flex; align-items:center; gap:36px; width:max-content; animation:g-marquee 38s linear infinite; }
  .g-marquee:hover .g-logo-track { animation-play-state:paused; }
  .g-logo-track li { flex:none; height:34px; display:flex; align-items:center; }
  .g-logo-track img { height:100%; width:auto; max-width:130px; object-fit:contain; }
  @keyframes g-marquee { from { transform:translateX(0); } to { transform:translateX(calc(-50% - 18px)); } }
  @media (prefers-reduced-motion: reduce) { .g-logo-track { animation:none; flex-wrap:wrap; width:auto; justify-content:center; } .g-logo-track li[aria-hidden="true"] { display:none; } }

  /* How it works heading */
  .g-h2-how { line-height:1.55; }
  .g-hw-note { display:inline-block; font-family:Caveat, cursive; font-weight:700; font-size:35px; line-height:1.05; letter-spacing:0; color:#2B2A6B; background:#FFFCF2; padding:0 9px 3px; border-radius:3px; transform:rotate(-2deg); box-shadow:0 3px 8px rgba(0,0,0,.25); }
  .g-hw-chip { display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono', monospace; font-weight:600; font-size:20px; line-height:1.2; letter-spacing:-.3px; color:#fff; background:#17181D; border:1px solid #3A3D46; padding:4px 10px; border-radius:7px; vertical-align:middle; white-space:nowrap; }
  .g-hw-chip svg { width:16px; height:16px; }

  /* Product video (click to play) */
  .g-video { position:relative; aspect-ratio:16/9; border-radius:14px; overflow:hidden; background:#17181D; border:1px solid #2A2C33; }
  .g-video-btn { position:absolute; inset:0; width:100%; height:100%; padding:0; border:0; background:none; cursor:pointer; display:block; }
  .g-video-btn img { width:100%; height:100%; object-fit:cover; display:block; }
  .g-play { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:64px; height:64px; border-radius:50%; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 24px rgba(0,0,0,.35); transition:transform .15s; }
  .g-play svg { width:26px; height:26px; margin-left:3px; }
  .g-video-btn:hover .g-play, .g-video-btn:focus-visible .g-play { transform:translate(-50%,-50%) scale(1.08); }
  /* the player is injected on click, so it has no Astro scope attribute: target it with :global */
  .g-video :global(iframe) { position:absolute; inset:0; width:100%; height:100%; border:0; display:block; }
  .g-video-cap { margin:10px 0 0; font-size:12.5px; color:#B4B8C2; }

  /* Stories + features headings */
  .g-strike { position:relative; display:inline-block; color:#8A8E98; }
  .g-strike svg { position:absolute; left:-4px; top:50%; width:calc(100% + 8px); height:16px; margin-top:-6px; overflow:visible; }
  .g-line { flex:none; width:28px; height:2px; background:var(--accent); }
  .g-ul { position:relative; display:inline-block; white-space:nowrap; color:inherit; }
  .g-ul svg { position:absolute; left:-2px; bottom:-9px; width:calc(100% + 4px); height:12px; overflow:visible; color:var(--accent); }

  /* Features: single-column list on phones */
  .g-feat-grid { display:flex; flex-direction:column; border-top:1px solid var(--line); }
  .g-feat { display:flex; align-items:flex-start; gap:14px; padding:16px 12px; border-bottom:1px solid var(--line); background:#fff; }
  .g-feat-hl { background:#EEF0FC; }
  .g-feat-hl .g-tile-feat { background:#fff; }
  .g-tile-feat { width:38px; height:38px; border-radius:10px; }
  .g-tile-feat svg { width:19px; height:19px; }
  .g-feat-txt { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .g-feat-t { font-size:15px; line-height:1.3; }
  .g-feat-b { font-size:13.5px; }

  @media (min-width: 960px) {
    .g-logo { width:32px; height:32px; }
    .g-logo-inv { width:28px; height:28px; }

    .g-cap { gap:14px; padding:10px 18px 10px 14px; border-radius:12px; }
    .g-cap-logo { height:23px; }
    .g-cap-div { height:34px; }
    .g-cap-txt { gap:3px; }
    .g-cap-row { gap:8px; }
    .g-cap-stars { font-size:18px; letter-spacing:1.5px; }
    .g-cap-score { font-size:18px; }
    .g-cap-sub { font-size:13px; }

    .g-trust { position:relative; z-index:2; margin-top:-44px; }
    .g-trust-wrap { padding:0 32px; }
    .g-trust-in { grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:8px; padding:14px; border-radius:16px; box-shadow:0 10px 30px rgba(14,15,18,.07); }
    .g-trust-i { gap:12px; padding:12px; }
    .g-tile { width:40px; height:40px; border-radius:10px; }
    .g-tile svg { width:19px; height:19px; }
    .g-trust-l { font-size:15.5px; }
    .g-trust-s { font-size:13px; line-height:1.4; }

    .g-logos-in { flex-wrap:nowrap; gap:48px; }
    .g-logos-in .g-eyebrow { flex:none; }
    .g-marquee { flex:1; min-width:0; margin:0; }
    .g-logo-track { gap:48px; }
    .g-logo-track li { height:40px; }
    .g-logo-track img { max-width:150px; }
    @keyframes g-marquee { from { transform:translateX(0); } to { transform:translateX(calc(-50% - 24px)); } }

    .g-h2-how { line-height:1.5; }
    .g-hw-note { font-size:58px; padding:0 14px 4px; border-radius:4px; box-shadow:0 5px 14px rgba(0,0,0,.3); }
    .g-hw-chip { font-size:34px; gap:10px; letter-spacing:-.8px; padding:6px 16px; border-radius:10px; }
    .g-hw-chip svg { width:26px; height:26px; }
    .g-video { border-radius:16px; }
    .g-play { width:76px; height:76px; }
    .g-play svg { width:30px; height:30px; }
    .g-video-cap { font-size:13.5px; }

    .g-strike svg { left:-6px; width:calc(100% + 12px); height:24px; margin-top:-9px; }
    .g-line { width:36px; }
    .g-ul svg { left:-3px; bottom:-14px; width:calc(100% + 6px); height:18px; }

    .g-feat-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); border-left:1px solid var(--line); }
    .g-feat { flex-direction:column; gap:12px; padding:30px 28px; border-right:1px solid var(--line); }
    .g-tile-feat { width:46px; height:46px; border-radius:12px; }
    .g-tile-feat svg { width:22px; height:22px; }
    .g-feat-txt { gap:12px; }
    .g-feat-t { font-size:19px; }
    .g-feat-b { font-size:15px; }
  }
</style>

<script>
  import { routeLead, sendToRouterWebhook, showLoading, showResult } from "../../scripts/leadRouter";
  import { buildSignupUrl, getClickIds, getUtms, persistAttribution, tenDigitPhone } from "../../scripts/signupRedirect";

  declare global { interface Window { LEAD_REFERENCE?: string } }

  const PAGE_KEY = "gads-tally-automation";
  const CONTACT_SOURCE = "Tally Automation - gads";
  const ROUTER_TOOLS = ["tally", "both"]; // everything else: in-form thank-you, no router
  const LEGACY_WEBHOOK = "https://n8n.aiaccountant.com/webhook/ce246056-bdd0-4199-b363-3b44ed255f96";
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  persistAttribution(); // UTMs + click IDs kept for the session

  // CTAs jump to the form and focus the first field.
  document.querySelectorAll<HTMLAnchorElement>("[data-to-form]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("form")?.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => (document.getElementById("g-name") as HTMLInputElement | null)?.focus({ preventScroll: true }), 450);
    }));

  const form = document.getElementById("g-form") as HTMLFormElement;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const name = $<HTMLInputElement>("g-name"), email = $<HTMLInputElement>("g-email"), phone = $<HTMLInputElement>("g-phone");
  const company = $<HTMLInputElement>("g-company"), tool = $<HTMLSelectElement>("g-tool"), setup = $<HTMLSelectElement>("g-setup");
  const setupWrap = $<HTMLElement>("g-setup-wrap"), team = $<HTMLSelectElement>("g-team"), role = $<HTMLSelectElement>("g-role");
  const btn = $<HTMLButtonElement>("g-submit"), success = $<HTMLElement>("g-success");
  const honeypot = form.querySelector<HTMLInputElement>('input[name="lr_hpf_x7"]');

  const mark = (el: HTMLElement, bad: boolean) => el.closest(".g-f")?.classList.toggle("bad", bad);
  [name, email, phone, company, tool, setup, team, role].forEach((el) => {
    el.addEventListener("input", () => mark(el, false));
    el.addEventListener("change", () => mark(el, false));
  });

  // Digits only; a pasted "+91 98765 43210" keeps the real 10 digits.
  phone.addEventListener("input", () => {
    let d = phone.value.replace(/\D/g, "");
    if (d.length > 10) d = d.replace(/^(91|0)/, "");
    phone.value = d.slice(0, 10);
  });

  // "Is your Tally on cloud or local?" only for Tally / Both.
  const syncSetup = () => {
    const on = ROUTER_TOOLS.some((t) => tool.value.toLowerCase().includes(t));
    setupWrap.hidden = !on; setup.disabled = !on; setup.required = on;
    form.classList.toggle("no-setup", !on);
    if (!on) { setup.selectedIndex = 0; mark(setup, false); }
  };
  tool.addEventListener("change", syncSetup);
  syncSetup();

  const validate = () => {
    const checks: [HTMLElement, boolean][] = [
      [name, !!name.value.trim()],
      [email, EMAIL_RE.test(email.value.trim())],
      [phone, tenDigitPhone(phone.value).length === 10],
      [company, !!company.value.trim()],
      [tool, !!tool.value],
      [setup, !setup.required || !!setup.value],
      [team, !!team.value],
      [role, !!role.value],
    ];
    checks.forEach(([el, ok]) => mark(el, !ok));
    const bad = checks.find(([, ok]) => !ok)?.[0];
    if (bad) { bad.scrollIntoView({ behavior: "smooth", block: "center" }); bad.focus({ preventScroll: true }); }
    return !bad;
  };

  // Pre-filled sign-up link, same contract as the self-onboarding page (full name split into first/last).
  const signupLink = (p: Record<string, string>) => {
    const l = { ...p };
    if (l.first_name && l.first_name.includes(" ")) { // one name box: split for the sign-up page
      const parts = l.first_name.trim().split(/\s+/);
      l.first_name = parts.shift() || ""; l.last_name = parts.join(" ");
    }
    return buildSignupUrl(l);
  };

  // "How it works" video: thumbnail + play button; the YouTube player loads only on click.
  document.querySelectorAll<HTMLButtonElement>(".g-video-btn").forEach((b) =>
    b.addEventListener("click", () => {
      const id = b.dataset.yt; if (!id) return;
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      f.title = "Automate Tally bill entries with AI Accountant";
      f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      f.allowFullscreen = true;
      b.replaceWith(f);
    }));

  const showSuccess = () => {
    form.style.display = "none";
    success.hidden = false;
    success.scrollIntoView({ behavior: "smooth", block: "center" });
    success.focus({ preventScroll: true });
  };

  let busy = false;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (busy || !validate()) return;
    busy = true; btn.disabled = true; btn.textContent = "Submitting...";

    const fullName = name.value.trim();
    const phone10 = tenDigitPhone(phone.value);
    const utm = getUtms(), clickIds = getClickIds();
    const payload: Record<string, string> = {
      first_name: fullName,
      email: email.value.trim(),
      company: company.value.trim(),
      lg__phone: phone10,
      which_accounting_tool_do_you_use: tool.value,
      tally_setup: setup.disabled ? "" : setup.value,
      accounting_team_size: team.value,
      which_best_describes_you: role.value,
      contact_source: CONTACT_SOURCE,
      campaign: "gads-tally-automation",
      lead_reference: window.LEAD_REFERENCE || "",
      lr_hpf_x7: honeypot?.value || "",
      __page: location.href,
      ...utm, ...clickIds,
    };
    Object.keys(payload).forEach((k) => { if (!payload[k]) delete payload[k]; });

    // Bot trap filled: show the thank-you, send nothing (no GM turn used).
    if (payload.lr_hpf_x7) { showSuccess(); return; }

    // Not Tally / Both: record the lead, thank-you in place, no router.
    if (!ROUTER_TOOLS.includes(tool.value.toLowerCase())) {
      try {
        fetch(LEGACY_WEBHOOK, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...payload, __event: "form_submit_blocked_tool" }), keepalive: true })
          .catch((err) => console.error("[gads-ta] blocked-tool webhook failed", err));
      } catch (err) { console.error("[gads-ta] blocked-tool webhook failed", err); }
      showSuccess();
      return;
    }

    // Tally / Both (26 Nov): same flow as the self-onboarding page.
    // Enterprise = 5+ accountants (5-10 / 10+) and not a CA firm / channel partner -> router sends them to Deb;
    // they stay on the page and see Deb's WhatsApp card. Everyone else -> router + HubSpot, then straight to the
    // pre-filled sign-up page (no popup).
    const isEnterprise = ["5-10", "10+"].includes(team.value) && !/^(ca firm|channel partner)/i.test(role.value);
    if (isEnterprise) showLoading();
    else btn.textContent = "Setting up your account...";

    // 1. Owner + token (router self-caps at 4s, never throws; guarded anyway so 2 and 3 always run).
    let result: Awaited<ReturnType<typeof routeLead>> = null;
    try {
      result = await routeLead({ pageKey: PAGE_KEY, email: payload.email, name: fullName, phone: phone10, fields: payload, utm, clickIds });
      if (!result || !result.ok) console.error("[gads-ta] routeLead returned no owner", result);
    } catch (err) { console.error("[gads-ta] routeLead failed", err); }

    // 2. HubSpot via n8n, fire and forget (keepalive survives the navigation).
    try { sendToRouterWebhook(payload, result); } catch (err) { console.error("[gads-ta] router webhook failed", err); }

    // Enterprise: stay on the page, Deb's card (GM card if Deb is out of office; generic card if the router failed).
    if (isEnterprise) {
      showSuccess();
      showResult(result, fullName.split(/\s+/)[0] || fullName, { track: true });
      return;
    }

    // 3. Sign-up page, pre-filled (full name split into first/last, type=external; real UTMs kept).
    window.location.assign(signupLink(payload));
  });

  // bfcache: coming back from the sign-up page must give a usable form again.
  window.addEventListener("pageshow", (ev) => {
    if (ev.persisted) { busy = false; btn.disabled = false; btn.textContent = "Start Free Trial →"; }
  });
</script>
